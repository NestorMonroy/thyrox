# Python
__pycache__/
*.pyc
.venv/
# `env/` va ANCLADO a la raiz: sin la barra inicial git lo aplica a CUALQUIER
# directorio llamado `env` a cualquier profundidad, y se trago los tres .ts de
# `src/packages/config/env/` — codigo fuente, no un virtualenv. El agente que
# los porto tuvo que forzarlos con `git add -f`; sin eso habrian desaparecido
# del commit en silencio, que es la forma cara de perder trabajo.
/env/
venv/

# El diario de SQLite NO es el store: es su bitácora en vuelo. `-wal` y `-shm`
# existen sólo mientras hay un escritor abierto, y su contenido pertenece al
# `.sqlite3` en cuanto se consolida (`PRAGMA wal_checkpoint`). Versionarlos
# no añade evidencia —la evidencia ya está en el store— y sí puede confundir:
# un `-wal` viejo junto a un store consolidado describe un estado que no es.
# NO contradice la directiva de arriba: lo que ella preserva es el store, y
# esto no es el store.
*.sqlite3-wal
*.sqlite3-shm

# Estado de GNU parallel: lo escribe la herramienta, como .venv y node_modules.
.parallel/

# Puntero de sesión al último banco creado — cambia con cada banco y no es
# contenido: versionarlo produce el churn por turno de #151. El banco SÍ se
# versiona; su puntero, no.
.claude/workbench/.ultimo-banco
# El renombre a inglés de `identificadores-en-ingles.md` dejó esta entrada
# apuntando al nombre muerto: el puntero vivo es `.last-bank`, que quedó
# sin ignorar y aparecía como `??` en cada turno. Se conservan los dos
# nombres porque el viejo sigue en el árbol de trabajo de este clon.
.claude/workbench/.last-bank

# Estado de sesión del gate de mutación: qué mutación está EN VUELO ahora.
# No es registro del proyecto — su contenido sólo vale dentro de la ejecución
# que lo escribió, y versionarlo ensucia el árbol en cada corrida.
#
# Las DOS formas, y no es redundancia: el ledger se emite hoy como `.jsonl`
# (un registro por línea, que sobrevive a la muerte del proceso porque un
# append no puede pisar lo ya escrito), y el lector sigue aceptando el `.json`
# heredado de forma permanente — un ledger escrito por una sesión anterior no
# se convierte al leerse. Declarar sólo la forma nueva dejaría al heredado
# fuera del ignore; declarar sólo la vieja fue el defecto que esta línea
# corrige.
agent-results/mutantes-en-vuelo.json
agent-results/mutantes-en-vuelo.jsonl

# El ledger de trabajos en segundo plano es POR SESIÓN
# (.env.example: THYROX_JOBS_DIR/THYROX_JOBS_ARCHIVE_DIR) — dos sesiones que
# compartieran uno se robarían los marcadores entre sí. Su contenido sólo
# vale mientras la sesión que lo escribió sigue viva; versionarlo ensucia el
# árbol cada vez que un trabajo queda VIVO al cerrar el turno.
.claude/jobs-ledger/

# La cascara de store del proveedor: 0 filas de negocio, tracked sin el
# driver de merge que .gitattributes da al store real. La retira TASK-THYROX-0153.
.claude/agent-results/agent_store.sqlite3
