#!/usr/bin/env bash
# Generado por src/session/generate_bin.py — no editar a mano.
THYROX_ROOT="${THYROX_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export THYROX_ROOT
LIB="$THYROX_ROOT/src/lib/toolchain.sh"
if [ ! -r "$LIB" ]; then
  echo "bin/headless-sdk-generate-core-types: no alcanza $LIB — el arbol esta incompleto." >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$LIB"
thyrox_toolchain_require_bun || exit 1
exec "${THYROX_TOOLCHAIN_BUN_BIN:-bun}" "$THYROX_ROOT/src/packages/headless-sdk/bin/generateCoreTypes.ts" "$@"
