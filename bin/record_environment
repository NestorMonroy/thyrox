#!/usr/bin/env bash
# Generado por src/session/generate_bin.py — no editar a mano.
THYROX_ROOT="${THYROX_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export THYROX_ROOT
INTERPRETER="$THYROX_ROOT/.venv/bin/python"
if [ ! -x "$INTERPRETER" ]; then
  RESCUE="$(command -v "${THYROX_PYTHON_FALLBACK:-python3}" 2>/dev/null)"
  if [ -n "$RESCUE" ] && "$RESCUE" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
    echo "bin/record_environment: sin entorno del proveedor; corre con $RESCUE." >&2
    echo "              Generalo con: cd \"$THYROX_ROOT\" && uv sync" >&2
    INTERPRETER="$RESCUE"
  else
    LIB="$THYROX_ROOT/src/lib/toolchain.sh"
    if [ -r "$LIB" ]; then
      # shellcheck source=/dev/null
      source "$LIB"
      thyrox_toolchain_degraded_notice \
        "las herramientas Python de bin/, record_environment entre ellas" \
        "cd \"$THYROX_ROOT\" && uv sync" >&2
    fi
    echo "bin/record_environment: falta el entorno del proveedor en $INTERPRETER." >&2
    echo "              Generalo con: cd \"$THYROX_ROOT\" && uv sync" >&2
    exit 1
  fi
fi
export PYTHONPATH="$THYROX_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$INTERPRETER" "$THYROX_ROOT/src/session/record_environment.py" "$@"
