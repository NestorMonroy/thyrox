+    try {
+      process.env.THYROX_CONFIG_DIR = '/global'
+      expect(resolveDataDir(ENV_VAR, SUBDIR, { THYROX_CONFIG_DIR: '/inyectado' })).toBe(join('/inyectado', SUBDIR))
