+                   '  *--query-compute-apps=pid,used_memory*) echo "4242, 300"; echo "4343, 5000" ;;\n'
+                   '  *--query-gpu=index,utilization.gpu*)    echo "0, 91"; echo "1, 12" ;;\n'
+                   f"  *--query-gpu=index,memory.free*)        printf '{free_rows}' ;;\n"
+                   '  *) exit 9 ;;\nesac\n')
+    smi.chmod(0o755)
+    return smi
+
