+// Suite del vocabulario de esfuerzo — TDD: se escribe antes de unificarlo.
+//
+// El vocabulario vive HOY (antes de este porte) en tres sitios: `effort.ts`
+// (`EFFORT_LEVELS`, 6 niveles con `none`), `schema.ts` (`EFFORT_LEVELS`, 5
+// niveles sin `none`, para el `effort:` del frontmatter) y `models.ts` (el
+// tipo `EffortLevel`, 5 niveles sin `none`, para `default_effort` y
+// `effort_cost_index`). Esta suite mide que quede UNA sola constante base —
+// en `effort.ts`— y que las otras dos DERIVEN de ella, no la copien: el
+// control de identidad (`toBe`, no `toEqual`) es lo que distingue derivar de
+// copiar, igual que ya hace `contract.test.ts` para `schema.ts`/`types.ts`.
+import { describe, expect, test } from 'bun:test'
+import { EFFORT_LEVELS, NAMED_EFFORT_LEVELS } from '../effort.ts'
+import { AgentJsonSchema, EFFORT_LEVELS as EFFORT_FROM_SCHEMA } from '../schema.ts'
+import { effortCostIndex, MODELS } from '../models.ts'
+
+describe('la base vive en effort.ts', () => {
+  test('EFFORT_LEVELS es el vocabulario de 6 niveles, con none primero', () => {
+    expect([...EFFORT_LEVELS]).toEqual(['none', 'low', 'medium', 'high', 'xhigh', 'max'])
+  })
+
+  test('NAMED_EFFORT_LEVELS es el subconjunto sin none, mismo orden', () => {
+    expect([...NAMED_EFFORT_LEVELS]).toEqual(['low', 'medium', 'high', 'xhigh', 'max'])
+  })
+})
+
+describe('schema.ts DERIVA, no copia', () => {
+  test('su EFFORT_LEVELS es el MISMO arreglo que NAMED_EFFORT_LEVELS de effort.ts', () => {
+    // La igualdad por valor pasaría con dos listas iguales escritas dos veces;
+    // la identidad sólo pasa si es la misma referencia re-exportada.
+    expect(EFFORT_FROM_SCHEMA).toBe(NAMED_EFFORT_LEVELS)
+  })
+
+  test('sigue rechazando el frontmatter con effort:none (comportamiento sin cambio)', () => {
+    const result = AgentJsonSchema.safeParse({
+      description: 'x', prompt: 'y', effort: 'none',
+    })
+    expect(result.success).toBe(false)
+  })
+
+  test('sigue aceptando los cinco niveles nombrados (comportamiento sin cambio)', () => {
+    for (const level of NAMED_EFFORT_LEVELS) {
+      const result = AgentJsonSchema.safeParse({ description: 'x', prompt: 'y', effort: level })
+      expect(result.success).toBe(true)
+    }
+  })
+})
+
+describe('models.ts CONSUME el tipo derivado, sin redeclarar el literal', () => {
+  test('effortCostIndex acepta los cinco niveles nombrados del catálogo real', () => {
+    const [modelId, record] = Object.entries(MODELS).find(
+      ([, r]) => r.effort_cost_index !== undefined,
+    ) ?? []
+    expect(modelId).toBeDefined()
+    for (const level of NAMED_EFFORT_LEVELS) {
+      // No debe lanzar y debe devolver number|null para cada nivel del vocabulario base.
+      expect(typeof effortCostIndex(modelId as string, level)).not.toBe('undefined')
+    }
+    expect(record).toBeDefined()
+  })
+})
