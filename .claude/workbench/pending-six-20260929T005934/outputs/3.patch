@@ -73,6 +75,16 @@ export const EFFORT_LEVELS = [
 export type EffortLevel = (typeof EFFORT_LEVELS)[number]
 export type EffortValue = EffortLevel | number
 
+// El subconjunto persistible/nombrado, sin 'none' — el vocabulario que
+// `schema.ts` valida en el frontmatter y que `models.ts` usa para
+// `default_effort`/`effort_cost_index`. Se deriva por POSICIÓN ('none' es
+// siempre el primero) en vez de filtrar: la destructuración de un tuple
+// `as const` conserva el tipo literal-tupla que `z.enum` exige, y `.filter`
+// lo degradaría a un arreglo suelto.
+const [, ...NAMED_EFFORT_LEVELS] = EFFORT_LEVELS
+export { NAMED_EFFORT_LEVELS }
+export type NamedEffortLevel = (typeof NAMED_EFFORT_LEVELS)[number]
+
 export function isEffortLevel(value: string): value is EffortLevel {
   return (EFFORT_LEVELS as readonly string[]).includes(value)
 }
