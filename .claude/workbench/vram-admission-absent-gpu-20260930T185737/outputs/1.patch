+ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
+GPU="$ROOT/bin/gpu_monitor"
+T="$(mktemp -d)"; trap 'rm -rf "${T:?}"' EXIT
+total=0; failures=0
+check() { total=$((total+1)); if [[ "$2" == "$3" ]]; then echo "OK   $1"; else echo "FALLA $1 — esperado '$3', obtenido '$2'"; failures=$((failures+1)); fi; }
 
