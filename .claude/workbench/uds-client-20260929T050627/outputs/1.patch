+  for (let index = 0; index < records.length; index++) {
+    const { file, ...record } = records[index]!
+    if (verifiedLive[index]) {
+      live.push(record)
+    } else if (sweepPermitted && recordInPidDomain(record, sweepDomain) && isProcessGone(record.pid)) {
