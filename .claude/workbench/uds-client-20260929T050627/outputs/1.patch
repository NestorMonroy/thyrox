+    let settled = false
+    const finish = (value: boolean) => {
+      if (settled) return
+      settled = true
+      resolve(value)
+    }
+    const socket = connect({ path })
+    socket.on('connect', () => {
+      socket.destroy()
+      finish(true)
+    })
+    socket.on('error', error => {
+      socket.destroy()
+      finish(getErrnoCode(error) === 'EBUSY')
+    })
+    socket.setTimeout(250, () => {
+      socket.destroy()
+      finish(false)
+    })
