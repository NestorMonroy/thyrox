+  return { admit, checkHopChain, trackedSenderCount: () => buckets.size }
+}
+
+const KNOWN_DROP_REASONS: ReadonlySet<string> = new Set(['rate-limited', 'duplicate', 'hop-loop', 'hop-runaway', 'queue-full'])
