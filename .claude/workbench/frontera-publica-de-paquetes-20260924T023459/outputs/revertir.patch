+  const hooks: ConfiguredHook[] = []
+  for (const group of configuredMatchers(event)) {
+    if (!hookMatcherMatches(group.matcher, matchQuery)) continue
+    for (const hook of group.hooks ?? []) hooks.push(hook)
+  }
