+export const EXECUTION_RUNTIMES = ['ollama', 'claude-cli'] as const
+export type ExecutionRuntime = (typeof EXECUTION_RUNTIMES)[number]
+
+/**
+ * Lo que quien despacha permite y lo que el plano de control midió caído. La
+ * decisión de caer a otro runtime vive aquí, no en el orquestador: un pool
+ * que reintenta con `claude-cli` por su cuenta decide un proveedor que nadie
+ * autorizó.
+ */
+export type ExecutionPolicy = {
+  allowedRuntimes: readonly ExecutionRuntime[]
+  unavailableRuntimes: readonly ExecutionRuntime[]
+}
+
+/** La política sin declarar: los dos runtimes, ninguno caído (decisión del 2026-10-01). */
+export const OPEN_EXECUTION_POLICY: ExecutionPolicy = { allowedRuntimes: EXECUTION_RUNTIMES, unavailableRuntimes: [] }
+
+export type NoCandidateCode = 'no_candidate' | 'runtime_unavailable'
+
+/** Ningún runtime permitido y disponible tiene candidato: se rehúsa, nunca se cae a otro. */
+export class NoCandidateError extends Error {
+  constructor(readonly code: NoCandidateCode, detail: string) {
+    super(`${code}: ${detail}`)
+    this.name = 'NoCandidateError'
+  }
+}
+
+function usable(policy: ExecutionPolicy, runtime: ExecutionRuntime): boolean {
+  return policy.allowedRuntimes.includes(runtime) && !policy.unavailableRuntimes.includes(runtime)
+}
+
+/** Por qué el modelo local no sirve: caído según el plano de control, o sin candidato medido. */
+function localUnusableReason(kind: TaskKind, profile: TurnProfile, local: LocalModelInventory, policy: ExecutionPolicy): string {
+  if (!policy.allowedRuntimes.includes('ollama')) return 'ollama no permitido por la política'
+  if (policy.unavailableRuntimes.includes('ollama')) return 'ollama no disponible según el plano de control'
+  return localFallbackReason(kind, profile, local)
+}
+
 /**
- * Elige dónde se ejecuta una clase de tarea: el modelo local más rápido de los
- * que una medición aprobó para la clase con contexto suficiente; si no hay
- * ninguno, la recomendación del catálogo del proveedor por `claude-cli`, con
- * la causa concreta en `fallbackReason`.
+ * Elige dónde se ejecuta una clase de tarea dentro de lo que la política
+ * permite: el modelo local más rápido de los que una medición aprobó para la
+ * clase con contexto suficiente; si no hay ninguno y la política permite el
+ * proveedor, su catálogo por `claude-cli` con la causa en `fallbackReason`.
+ * Si no queda ningún runtime permitido y disponible, `NoCandidateError`.
  */
 export function recommendExecution(
   kind: TaskKind,
   profile: TurnProfile,
   local: LocalModelInventory,
+  policy: ExecutionPolicy = OPEN_EXECUTION_POLICY,
 ): ExecutionRecommendation {
-  const [fastest] = qualifiedModels(local.entries, local.qualifications, kind, profile.contextTokens)
-  if (fastest) {
-    return {
-      runtime: 'ollama',
-      model: fastest.entry.name,
-      taskClass: kind,
-      contextTokens: profile.contextTokens,
-      qualification: fastest.qualification,
+  if (usable(policy, 'ollama')) {
+    const [fastest] = qualifiedModels(local.entries, local.qualifications, kind, profile.contextTokens)
+    if (fastest) {
+      return {
+        runtime: 'ollama',
+        model: fastest.entry.name,
+        taskClass: kind,
+        contextTokens: profile.contextTokens,
+        qualification: fastest.qualification,
+      }
     }
   }
-  return { ...providerExecution(kind, profile), fallbackReason: localFallbackReason(kind, profile, local) }
+  const localReason = localUnusableReason(kind, profile, local, policy)
+  if (usable(policy, 'claude-cli')) {
+    const execution = providerExecution(kind, profile)
+    return policy.allowedRuntimes.includes('ollama') ? { ...execution, fallbackReason: localReason } : execution
+  }
+  const code: NoCandidateCode = policy.unavailableRuntimes.some((runtime) => policy.allowedRuntimes.includes(runtime))
+    ? 'runtime_unavailable' : 'no_candidate'
+  throw new NoCandidateError(code, `ningún runtime permitido (${policy.allowedRuntimes.join(', ') || 'ninguno'}) `
+    + `tiene candidato para ${kind}; ${localReason}`)
 }
 
