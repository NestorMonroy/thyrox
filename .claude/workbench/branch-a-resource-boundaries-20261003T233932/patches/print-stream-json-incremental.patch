+    expect(written).toHaveLength(1)
+    appendFileSync(transcriptPath, 'age":{"id":"m1"}}\n')
+    emitter.onEvent({ type: 'turn_start', turn: 2 })
+    expect(written.map((l) => l.type)).toEqual(['system', 'assistant'])
