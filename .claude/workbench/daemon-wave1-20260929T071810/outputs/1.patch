+      const held = readDaemonLock(lockPath)
+      if (held && isProcessAlive(held.pid)) {
+        return { ok: false, lock: held, outcome: classifyLiveLockOutcome(held.pid) }
+      }
+      return { ok: false, lock: held ?? info, outcome: 'unverified' }
+    }
