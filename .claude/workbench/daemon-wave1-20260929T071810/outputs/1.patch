+async function tryAcquireOnce(
+  lockPath: string,
+  info: DaemonLockInfo,
+): Promise<LockAcquireResult | LockConflictResult | 'retry'> {
+  if (writeLockExclusive(lockPath, info)) return { ok: true, lock: info }
+  const held = readDaemonLock(lockPath)
