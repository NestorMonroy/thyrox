+#: (``src/packages/task/schema.ts::TASK_HIGHWATER_DDL``), solo para
+#: reconocerla si una base la trae — nunca para crearla.
+_TASK_HIGHWATER_LEGACY_COLUMNS = {"clave", "max_id"}
+
+
