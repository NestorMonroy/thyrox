 export const TASK_HIGHWATER_DDL = `CREATE TABLE IF NOT EXISTS task_highwater (
-  clave  TEXT NOT NULL PRIMARY KEY DEFAULT '__global__',
-  max_id INTEGER NOT NULL DEFAULT 0
+  session_id   TEXT NOT NULL PRIMARY KEY,
+  next_task_id INTEGER NOT NULL
 )`
 
+/**
+ * Prepara `task_highwater`, migrando la forma vieja si hace falta.
+ *
+ * La forma vieja (`clave`/`max_id`, PRIMARY KEY `clave`) guardaba una marca
+ * GLOBAL, ajena a cualquier sesión: no hay `session_id` al que atribuirla, así
+ * que se descarta entera en vez de traducirse fila a fila. `nextTaskId`
+ * (`tools/tasks.ts`) adopta el próximo id de cada sesión de sus propias filas
+ * de `tasks` la primera vez que la necesita — el mismo camino que una base sin
+ * ninguna tabla `task_highwater` todavía.
+ */
+export function ensureTaskHighwater(db: Database): void {
+  const columnas = (db.query('PRAGMA table_info(task_highwater)').all() as { name: string }[]).map((c) => c.name)
+  const formaVieja = columnas.length > 0 && !columnas.includes('session_id')
+  if (!formaVieja) {
+    db.run(TASK_HIGHWATER_DDL)
+    return
+  }
+  db.run('BEGIN IMMEDIATE')
+  try {
+    db.run('DROP TABLE task_highwater')
+    db.run(TASK_HIGHWATER_DDL)
+    db.run('COMMIT')
+  } catch (e) {
+    db.run('ROLLBACK')
+    throw e
+  }
+}
