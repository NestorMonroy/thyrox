+  const finishedAt = effective === 'idle' ? (sameTurn ? hostState.idleSince : undefined) : Date.now()
+  const detailEligible = (subscriber: IdleSubscriber) => runtime.inboundPolicyFor({ fromMode: subscriber.fromMode, selfSent: subscriber.selfSent }) === 'accept'
+  const detail = effective === 'idle' && sameTurn && subscribers.some(subscriber => subscriber.verifiedPeerPid !== undefined && detailEligible(subscriber)) ? lastTurnDetail(host) : undefined
+  let registered = new Map<number, string>()
+  if (subscribers.some(subscriber => subscriber.verifiedPeerPid !== undefined)) {
+    try {
+      registered = (await hostState.registeredInboxOfPid?.(subscribers.flatMap(subscriber => (subscriber.verifiedPeerPid === undefined ? [] : [subscriber.verifiedPeerPid])))) ?? new Map()
+    } catch (error) {
+      logForDebugging(`[peer-idle] registry unreadable at fire time; notices carry no detail (${redactLogFragment(String(error))})`)
+    }
+  }
+  if (runtime.localInboundPolicy() === 'refuse') {
+    reportFeatureSad('cross_session_notify_idle', 'revoked_before_fire')
+    return
+  }
+  if (reason === 'idle' && (!hostState.idle || runtime.mainThreadQueueLength() > 0 || runtime.heldInboundCount() > 0)) {
+    mergeSubscribersBack(subscribers, host)
+    if (hostState.idle) {
+      const parked = runtime.heldInboundCount() > 0
+      hostState.parkedHoldBack = parked
+      scheduleFlush(parked ? PARKED_RETRY_MS : FLUSH_DEBOUNCE_MS, host)
+    }
+    return
+  }
+  const isRegisteredMatch = (subscriber: IdleSubscriber) => {
+    if (subscriber.verifiedPeerPid === undefined) return false
+    const address = registered.get(subscriber.verifiedPeerPid)
+    return address !== undefined && canonicalSocketAddress(address) === subscriber.targetKey
+  }
+  await Promise.all(
+    subscribers.map(subscriber => {
+      const matched = isRegisteredMatch(subscriber)
+      return sendNotice(
+        subscriber.replyTarget,
+        {
+          orig_msg_id: subscriber.origMsgId,
+          state: effective,
+          ...(finishedAt !== undefined && { finished_at: finishedAt }),
+          ...(detail !== undefined && matched && detailEligible(subscriber) && { detail }),
+        },
+        subscriber.verifiedPeerPid,
+        verifiedRecipient(subscriber.verifiedPeerPid, subscriber.authenticated),
+        subscriber.verifiedPeerProcStart,
+      ).then(
+        () => reportFeatureOk('cross_session_notify_idle'),
+        (error: unknown) => {
+          const outcome = classifySendOutcome(error, host)
+          if (reason === 'idle' && outcome === 'transient' && !subscriber.retried) {
+            mergeSubscribersBack([{ ...subscriber, retried: true }], host)
+            if (hostState.idle) scheduleFlush(FLUSH_DEBOUNCE_MS, host)
+            reportFeatureSad('cross_session_notify_idle', 'notice_send_retrying')
+            return
+          }
+          if (outcome === 'requester-gone') reportFeatureSad('cross_session_notify_idle', 'requester_gone')
+          else if (outcome === 'transient') reportFeatureSad('cross_session_notify_idle', subscriber.retried ? 'notice_retry_exhausted' : 'notice_transient_at_exit')
+          else reportFeatureBad('cross_session_notify_idle', 'notice_send_failed')
+          logForDebugging(`[peer-idle] notice to ${withholdTokenText(subscriber.replyAddress)} failed: ${redactLogFragment(String(error))}`)
+        },
+      )
+    }),
+  )
+}
+
+/** `KEn`: dispara el aviso a todos los suscriptores vivos, por quedar inactiva o por salir. */
+export async function flushIdleNotices(reason: 'idle' | 'exited', host: object = processHost): Promise<void> {
+  const state = idleState(host)
+  if (reason === 'exited') {
+    state.exited = true
+    if (state.inflight.size > 0) await Promise.all([...state.inflight].map(pending => pending.catch(() => {})))
+  }
+  const effective = reason === 'exited' && state.idle && state.runtime.mainThreadQueueLength() === 0 && !state.parkedHoldBack && state.runtime.heldInboundCount() === 0 ? 'idle' : reason
+  pruneExpiredSubscriptions(Date.now(), host)
+  if (state.subscribers.length === 0 || state.sendNotice === null) return
+  const sendNotice = state.sendNotice
+  const batch = state.subscribers.splice(0, state.subscribers.length)
+  state.inflightBatch = state.inflightBatch.concat(batch)
+  try {
+    await deliverIdleNotices(state, sendNotice, batch, reason, effective, host)
+  } catch (error) {
+    state.runtime.reportUncaughtError(error)
+    reportFeatureBad('cross_session_notify_idle', 'flush_internal_error')
+  } finally {
+    state.inflightBatch = state.inflightBatch.filter(subscriber => !batch.includes(subscriber))
+  }
+}
+
+/** `se`: reintenta un aviso "unavailable" que falló de forma transitoria. */
+function retryUnavailableNotice(target: string, msgId: string, verifiedPeerPid: number | undefined, authenticated: boolean, verifiedPeerProcStart: string | undefined, host: object = processHost): void {
+  idleState(host).unavailableRetries.delete(msgId)
+  sendUnavailableNotice(target, msgId, verifiedPeerPid, authenticated, verifiedPeerProcStart, true, host)
+}
+
+/** `pqt`: avisa a un suscriptor desalojado o rechazado que no va a recibir nada. */
+export function sendUnavailableNotice(
+  target: string,
+  msgId: string,
+  verifiedPeerPid: number | undefined,
+  authenticated: boolean,
+  verifiedPeerProcStart: string | undefined,
+  isRetry = false,
+  host: object = processHost,
+): void {
+  const state = idleState(host)
+  const sendNotice = state.sendNotice
+  if (sendNotice === null || state.runtime.localInboundPolicy() === 'refuse') return
+  sendNotice(target, { orig_msg_id: msgId, state: 'unavailable' }, verifiedPeerPid, verifiedRecipient(verifiedPeerPid, authenticated), verifiedPeerProcStart).then(
+    () => {},
+    (error: unknown) => {
+      const outcome = classifySendOutcome(error, host)
+      if (outcome === 'transient' && !isRetry) {
+        const timer = setTimeout(() => retryUnavailableNotice(target, msgId, verifiedPeerPid, authenticated, verifiedPeerProcStart, host), UNAVAILABLE_RETRY_MS)
+        timer.unref?.()
+        const prior = state.unavailableRetries.get(msgId)
+        if (prior !== undefined) clearTimeout(prior)
+        state.unavailableRetries.set(msgId, timer)
+        reportFeatureSad('cross_session_notify_idle', 'unavailable_send_retrying')
+        return
+      }
+      if (outcome === 'requester-gone') reportFeatureSad('cross_session_notify_idle', 'requester_gone')
+      else if (outcome === 'transient') reportFeatureSad('cross_session_notify_idle', 'unavailable_retry_exhausted')
+      else reportFeatureBad('cross_session_notify_idle', 'unavailable_send_failed')
+      logForDebugging(`[peer-idle] unavailable notice to ${withholdTokenText(target)} failed: ${redactLogFragment(String(error))}`)
+    },
+  )
+}
+
+/** `tnr`: encola en el prompt del agente el texto de cada noticia admitida. */
+export function injectAdmittedNoticesPrompt(notices: readonly AdmittedIdleNotice[], host: object = processHost): void {
+  if (notices.length === 0) return
+  idleState(host).runtime.enqueueSystemPrompt(notices.map(idleNoticePromptText).join('\n'))
+}
+
+/** `aEn`: como `replyableTarget` (`inboxDelivery.ts`), con el pid del par opcional. */
+function respondableAddress(from: string, ownSocket: string, verifiedPeerPid: number | undefined, ownerUids: readonly number[] | undefined): string | undefined {
+  if (!from.startsWith('uds:') || !isPeerAddress(from)) return undefined
+  const { target } = parseAddress(from)
+  return target && isReplyableSocket(target, ownSocket, { verifiedPeerPid, ownerUids }) ? target : undefined
+}
+
+export interface IdleNotificationDeps {
+  /** El estado del buzón: de aquí sale `c().activeSocketPath` y `peerDirOwnerUids`. */
+  state: InboxState
+  /** `ce`: si el mensaje lo envió esta misma sesión (`isSelfSent`, `PeerDeliveryDeps`). */
+  isSelfSent: (peer: PeerIdentity) => Promise<boolean>
+  /** El anfitrión del estado de aviso de inactividad; por omisión, el de este proceso. */
+  host?: object
+}
+
+/** Los dos ramales de `be` que disparan el aviso de inactividad entre sesiones. */
+export function idleNotificationControlActions(deps: IdleNotificationDeps): { notify_when_idle: ControlActionHandler; peer_idle_notice: ControlActionHandler } {
+  const host = deps.host ?? processHost
+
+  const notifyWhenIdle: ControlActionHandler = async (message: Frame, peer: PeerIdentity) => {
+    const frame = parseNotifyWhenIdleFrame(message)
+    if (frame === undefined) {
+      logForDebugging('[uds-messaging] notify_when_idle dropped: malformed frame')
+      reportFeatureSad('cross_session_notify_idle', 'malformed_frame')
+      return
+    }
+    const ownSocket = deps.state.activeSocketPath
+    if (ownSocket === undefined) {
+      logForDebugging('[uds-messaging] notify_when_idle dropped: own inbox not bound (shutting down)')
+      reportFeatureSad('cross_session_notify_idle', 'own_inbox_unbound')
+      return
+    }
+    const replyTarget = respondableAddress(frame.from, ownSocket, peer.pid, deps.state.peerDirOwnerUids)
+    if (replyTarget === undefined) {
+      logForDebugging(`[uds-messaging] notify_when_idle dropped: reply address unshaped or outside our socket namespace (${withholdTokenText(frame.from)})`)
+      reportFeatureSad('cross_session_notify_idle', 'unvettable_reply_target')
+      return
+    }
+    if (canonicalSocketAddress(replyTarget) === canonicalSocketAddress(ownSocket)) {
+      logForDebugging('[uds-messaging] notify_when_idle dropped: reply target is this session (self-target)')
+      reportFeatureSad('cross_session_notify_idle', 'self_target_frame')
+      return
+    }
+    const selfSent = await deps.isSelfSent(peer)
+    const fromMode = isEnvelopeMode(frame.from_mode) ? frame.from_mode : undefined
+    const outcome = subscribeToIdleNotice(frame.from, replyTarget, frame.msg_id, peer.pid, peer.startToken, peer.origin === 'peer', fromMode, selfSent, host)
+    logForDebugging(`[uds-messaging] notify_when_idle from ${withholdTokenText(frame.from)}: ${outcome}`)
+    if (outcome === 'full') sendUnavailableNotice(replyTarget, frame.msg_id, peer.pid, peer.origin === 'peer', peer.startToken, false, host)
+  }
+
+  const peerIdleNotice: ControlActionHandler = async (message: Frame, peer: PeerIdentity) => {
+    const frame = parsePeerIdleNoticeFrame(message)
+    if (frame === undefined) {
+      logForDebugging('[uds-messaging] peer_idle_notice dropped: malformed frame')
+      reportFeatureSad('cross_session_notify_idle', 'malformed_notice')
+      return
+    }
+    if (!hasOutstandingIdleRequest(frame.orig_msg_id, host)) {
+      logForDebugging('[uds-messaging] peer_idle_notice: dropped (uncorrelated / already delivered / expired)')
+      return
+    }
+    const selfSent = await deps.isSelfSent(peer)
+    const fromMode = isEnvelopeMode(frame.from_mode) ? frame.from_mode : undefined
+    if (!admitPeerIdleNotice(frame.orig_msg_id, frame.state, frame.finished_at, frame.detail, fromMode, selfSent, host)) {
+      logForDebugging(`[uds-messaging] peer_idle_notice not admitted: subscription for orig_msg_id=${withholdTokenText(frame.orig_msg_id)} was already consumed`)
+    }
+  }
+
+  return { notify_when_idle: notifyWhenIdle, peer_idle_notice: peerIdleNotice }
+}
