+    }
+    case 'exited':
+      return `${notice.label} exited${notice.finishedAt !== undefined ? ` at ${formatIdleNoticeTimestamp(notice.finishedAt)}` : ''} before going idle.`
+    case 'unavailable':
+      return `${notice.label} is not holding the idle subscription (${UNAVAILABLE_REASON_TEXT}) — no idle notice will come from it.`
+    case 'expired':
