+
+/** `Qtr`: el texto que anuncia que un proceso pidió que se le avise. */
+export function subscriptionAnnouncementText(replyAddress: string, hasVerifiedPeerPid: boolean): string {
+  return `A process claiming the address ${replyAddress}${hasVerifiedPeerPid ? '' : ' (no verifiable pid)'} asked to be told when this session is next idle — it will get one automated status notice; a one-line status detail is included only if that address is registered to the same process in the session registry (a same-user process can register itself).`
