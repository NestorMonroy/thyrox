+    case 'idle': {
+      const time = formatIdleNoticeTimestamp(notice.finishedAt)
+      return `[Cross-session idle notice] "${notice.label}", which you asked to be notified about, is idle now${time ? ` — it finished a turn at ${time}` : ''}.${notice.detail ? ` Its harness reports: «${notice.detail}».` : ''} ${disclaimer}`
