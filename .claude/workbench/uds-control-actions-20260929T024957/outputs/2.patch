@@ -0,0 +1,1022 @@
+/**
+ * El aviso de cruce de sesión "avísame cuando estés libre": una sesión pide
+ * que se le notifique cuando esta quede inactiva (`notify_when_idle`), esta
+ * lleva la lista de quien lo pidió y dispara el aviso con un debounce cuando
+ * de verdad se queda quieta; y del otro lado, la propia sesión que pidió el
+ * aviso lo recibe y lo admite (`peer_idle_notice`), correlacionado con su
+ * petición saliente.
+ *
+ * Porte COMPLETO de `chunk-s0w8kgdv.js` de 2.1.283 —constantes, `qtr`, `Ktr`,
+ * `Ytr`, `qEn`, `KEn`, `dqt`, `Xtr`, `ibt`, `uqt`, `Jtr`, `YEn`, `XEn`, `JEn`,
+ * `QEn`, `ZEn`, `Qtr`, `Ztr`, `enr`, `Uqo`, `pqt`, `tnr` y sus privadas (`F`,
+ * `l`, `P`, `Z`, `J`, `N`, `M`, `O`, `ee`, `E`, `ne`, `ie`, `te`, `C`, `U`,
+ * `A`, `oe`, `L`, `se`, `W`, `q`)— más los dos ramales de `be`
+ * (`chunk-yg53q7yp.js`) que lo disparan: `notify_when_idle` y
+ * `peer_idle_notice`, expuestos como `ControlActionHandler` en
+ * `idleNotificationControlActions(deps)`.
+ *
+ * Divergencias declaradas:
+ * - `qtr`/`Ktr` eran un esquema zod perezoso (`f(()=>u({...}))`); aquí son
+ *   `parseNotifyWhenIdleFrame`/`parsePeerIdleNoticeFrame`, validados a mano
+ *   con las mismas cotas (tipo por campo, opcionales, claves no declaradas
+ *   descartadas) — el paquete no depende de zod.
+ * - `B` (`chunk-153dnzje.js`, contar por predicado) y `mpt`
+ *   (`chunk-j2p7jgmc.js`, un `finished_at` numérico finito y acotado) son
+ *   primitivas puras de un chunk ajeno: se reproducen en línea como
+ *   `countMatching`/`isPlausibleTimestamp` en vez de inyectarse, porque no
+ *   dependen de estado ni de E/S.
+ * - `Ce` (`aLo`, chunk-q8a07cv0.js): ya portada como `isEnvelopeMode`
+ *   (`peerEnvelope.ts`); se reutiliza directamente.
+ * - `ce`: ya portada como `isSelfSent` (`PeerDeliveryDeps`, `inboxDelivery.ts`);
+ *   llega inyectada con el mismo campo y firma.
+ * - `aEn`/`replyableTarget` (`inboxDelivery.ts`) exige un pid de par ya
+ *   verificado (`number`); aquí el par puede no tener uno (`peer.pid`, del
+ *   registro de `InboxConnectionDeps`), así que se reproduce su cuerpo con el
+ *   tipo correcto (`respondableAddress`) en vez de forzar el tipo con una
+ *   aserción insegura.
+ * - `tSe`, `dnr`, `Ws`, `x7e`, `TNn`, `Htn`, `d`, `Mae`, `MV`, `gE`+`qe` y `Y`
+ *   viven en chunks de política de permisos, cola del hilo principal,
+ *   clasificación del texto del último turno y envío, todos fuera de este
+ *   alcance: llegan como `IdleNotificationRuntimeDeps`, con un valor por
+ *   omisión permisivo (acepta, sin retener nada, cola vacía) hasta que quien
+ *   integra los sustituye por los reales.
+ */
+import type { PeerIdentity } from './inboxConnection.ts'
+import { canonicalSocketAddress } from './inboxAuth.ts'
+import { isMessageId } from './inboxDelivery.ts'
+import type { InboxState } from './inboxState.ts'
+import type { ControlActionHandler } from './inboxRouting.ts'
+import { redactLogFragment, withholdTokenText } from './logRedaction.ts'
+import { reportFeatureBad, reportFeatureOk, reportFeatureSad } from './featureTelemetry.ts'
+import { sliceUnits } from './stringUnits.ts'
+import { truncateToWidth } from './cappedText.ts'
+import { PerHost, processHost } from './sessionNameState.ts'
+import { isPeerAddress, isReplyableSocket, parseAddress } from './peerAddress.ts'
+import { isEnvelopeMode, type EnvelopeMode } from './peerEnvelope.ts'
+import { logForDebugging } from '../debug.ts'
+
+type Frame = Record<string, unknown> & { type: string }
+
+/** `w7e`: cuántas suscripciones o peticiones salientes se recuerdan a la vez. */
+export const SUBSCRIPTION_TABLE_LIMIT = 32
+const UNAUTHENTICATED_SUBSCRIBER_LIMIT = 8
+const SAME_PID_SUBSCRIBER_LIMIT = 4
+const SAME_TARGET_AUTHENTICATED_LIMIT = 4
+/** `T`: una suscripción sin disparar caduca a las 12 h. */
+const SUBSCRIPTION_TTL_MS = 43200000
+/** `V`: peticiones salientes vivas por mismo destino. */
+const OUTSTANDING_PER_TARGET_LIMIT = 3
+/** `K`: debounce antes de disparar el aviso. */
+const FLUSH_DEBOUNCE_MS = 750
+/** `z`: reintento cuando hay entrada retenida. */
+const PARKED_RETRY_MS = 30000
+/** `X`: reintento de un aviso "unavailable". */
+const UNAVAILABLE_RETRY_MS = 750
+/** `D`: ancho del detalle de una línea de estado. */
+const DETAIL_MAX_WIDTH = 100
+/** `q`: por qué una suscripción no se sostuvo. */
+const UNAVAILABLE_REASON_TEXT =
+  'it is shutting down, its subscription table is full, a newer subscription displaced this one, or it answered in a form this version does not recognize'
+
+export type IdleSubscriber = {
+  targetKey: string
+  replyTarget: string
+  replyAddress: string
+  verifiedPeerPid: number | undefined
+  verifiedPeerProcStart: string | undefined
+  authenticated: boolean
+  fromMode: EnvelopeMode | undefined
+  selfSent: boolean
+  origMsgId: string
+  requestedAt: number
+  retried?: boolean
+}
+
+export type OutstandingIdleRequest = {
+  msgId: string
+  label: string
+  target: string
+  targetKey: string
+  conversationId: string
+  requestedAt: number
+  expiry: ReturnType<typeof setTimeout>
+}
+
+export type IdleNoticeGate = 'local' | { fromMode: EnvelopeMode | undefined; selfSent: boolean }
+
+export type PendingIdleNotice =
+  | { kind: 'expired'; label: string; gate: 'local' }
+  | { kind: 'idle' | 'exited' | 'unavailable'; label: string; finishedAt?: number; detail?: string; gate: IdleNoticeGate }
+
+export type AdmittedIdleNotice =
+  | { kind: 'expired'; label: string; modelVisible: boolean }
+  | { kind: 'idle' | 'exited' | 'unavailable'; label: string; finishedAt?: number; detail?: string; modelVisible: boolean }
+
+export type SubscribeOutcome = 'invalid' | 'refused' | 'full' | 'recorded' | 'refreshed'
+
+export type SendIdleNotice = (
+  target: string,
+  payload: { orig_msg_id: string; state: string; finished_at?: number; detail?: string },
+  verifiedPeerPid: number | undefined,
+  verifiedRecipient: boolean,
+  verifiedPeerProcStart: string | undefined,
+) => Promise<void>
+
+export type OnSubscribed = (replyAddress: string, hasVerifiedPeerPid: boolean, isReplay: boolean) => void
+
+export interface IdleNotificationRuntimeDeps {
+  /** `Y`. */
+  sessionId: () => string
+  /** `tSe`: la política local para mensajes de entrada de este tipo. */
+  localInboundPolicy: () => 'accept' | 'refuse' | string
+  /** `dnr`: la política para el remitente de este gate. */
+  inboundPolicyFor: (gate: { fromMode: EnvelopeMode | undefined; selfSent: boolean }) => 'accept' | 'refuse' | string
+  /** `x7e`: mensajes de entrada retenidos ahora mismo. */
+  heldInboundCount: () => number
+  /** `Ws`: si el modo de permisos deja llegar el aviso a quien lo pidió. */
+  requesterGateEnabled: () => boolean
+  /** `TNn`: elementos en la cola del hilo principal. */
+  mainThreadQueueLength: () => number
+  /** `Htn`: qué declara el texto del último turno. */
+  classifyTurnStatus: (text: string) => { detail?: string } | null
+  /** `d`: registra un error no capturado en la telemetría. */
+  reportUncaughtError: (error: unknown) => void
+  /** `Mae`: por qué falló un envío. */
+  classifySendFailure: (error: unknown) => 'busy' | 'gone' | 'other'
+  /** `MV`: la razón si el error es un rechazo de envío conocido. */
+  sendRefusalReason: (error: unknown) => 'endpoint-unverifiable' | 'wrong-endpoint' | undefined
+  /** `gE`+`qe`: encola un prompt de sistema con las noticias ya formateadas. */
+  enqueueSystemPrompt: (value: string) => void
+}
+
+const DEFAULT_RUNTIME_DEPS: IdleNotificationRuntimeDeps = {
+  sessionId: () => '',
+  localInboundPolicy: () => 'accept',
+  inboundPolicyFor: () => 'accept',
+  heldInboundCount: () => 0,
+  requesterGateEnabled: () => true,
+  mainThreadQueueLength: () => 0,
+  classifyTurnStatus: () => null,
+  reportUncaughtError: () => {},
+  classifySendFailure: () => 'other',
+  sendRefusalReason: () => undefined,
+  enqueueSystemPrompt: () => {},
+}
+
+/** `F`: el estado de aviso de inactividad de esta sesión. */
+class IdleNotificationState {
+  subscribers: IdleSubscriber[] = []
+  idle = false
+  idleSince = 0
+  busyObserved = false
+  turnEnded = false
+  turnConversationId: string | undefined = undefined
+  parkedHoldBack = false
+  exited = false
+  inflight = new Set<Promise<void>>()
+  inflightBatch: IdleSubscriber[] = []
+  unavailableRetries = new Map<string, ReturnType<typeof setTimeout>>()
+  debounce: ReturnType<typeof setTimeout> | null = null
+  getLastTurnText: (() => string) | null = null
+  sendNotice: SendIdleNotice | null = null
+  onSubscribed: OnSubscribed | null = null
+  pendingAnnounces: [string, boolean][] = []
+  pendingAnnounceOverflow = 0
+  onReplayDone: ((overflow: number) => void) | null = null
+  registeredInboxOfPid: ((pids: number[]) => Promise<Map<number, string>>) | null = null
+  outstanding: OutstandingIdleRequest[] = []
+  onNotice: ((notice: AdmittedIdleNotice) => void) | null = null
+  pendingNotices: { admitted: PendingIdleNotice; conversationId: string }[] = []
+  pendingNoticeOverflow = 0
+  hostStatusUnsubscribe: (() => void) | null = null
+  runtime: IdleNotificationRuntimeDeps = { ...DEFAULT_RUNTIME_DEPS }
+
+  reset(): void {
+    this.hostStatusUnsubscribe?.()
+    this.hostStatusUnsubscribe = null
+    this.subscribers.length = 0
+    this.pendingAnnounces.length = 0
+    this.pendingAnnounceOverflow = 0
+    this.pendingNotices.length = 0
+    this.pendingNoticeOverflow = 0
+    this.onReplayDone = null
+    this.idle = false
+    this.idleSince = 0
+    this.busyObserved = false
+    this.turnEnded = false
+    this.turnConversationId = undefined
+    this.parkedHoldBack = false
+    this.exited = false
+    this.inflight.clear()
+    this.inflightBatch = []
+    for (const timer of this.unavailableRetries.values()) clearTimeout(timer)
+    this.unavailableRetries.clear()
+    if (this.debounce) clearTimeout(this.debounce)
+    this.debounce = null
+    this.getLastTurnText = null
+    this.sendNotice = null
+    this.onSubscribed = null
+    this.registeredInboxOfPid = null
+    for (const entry of this.outstanding) clearTimeout(entry.expiry)
+    this.outstanding.length = 0
+    this.onNotice = null
+    this.runtime = { ...DEFAULT_RUNTIME_DEPS }
+  }
+}
+
+const registry = new PerHost<IdleNotificationState>(() => new IdleNotificationState())
+
+/** `l`: el estado de este anfitrión (por omisión, el de este proceso). */
+function idleState(host: object = processHost): IdleNotificationState {
+  return registry.of(host)
+}
+
+/** Vacía el estado del anfitrión, para aislar pruebas. */
+export function resetIdleNotificationState(host: object = processHost): void {
+  idleState(host).reset()
+}
+
+/** Reemplaza, parcial o totalmente, las dependencias fuera de este alcance (`tSe`, `dnr`, `x7e`, `Ws`, `TNn`, `Htn`, `d`, `Mae`, `MV`, `gE`+`qe`, `Y`). */
+export function setIdleNotificationRuntimeDeps(deps: Partial<IdleNotificationRuntimeDeps>, host: object = processHost): void {
+  const state = idleState(host)
+  state.runtime = { ...state.runtime, ...deps }
+}
+
+/** `B`: cuántos elementos de `items` cumplen `predicate`; primitiva pura, no de este alcance. */
+function countMatching<T>(items: readonly T[], predicate: (item: T) => boolean): number {
+  let count = 0
+  for (const item of items) if (predicate(item)) count++
+  return count
+}
+
+/** `mpt`: un `finished_at` que es un número finito, no negativo y dentro de una cota razonable; primitiva pura, no de este alcance. */
+function isPlausibleTimestamp(value: unknown): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= 4000000000000000
+}
+
+function verifiedRecipient(verifiedPeerPid: number | undefined, authenticated: boolean): boolean {
+  return verifiedPeerPid !== undefined || authenticated
+}
+
+export type NotifyWhenIdleFrame = {
+  action: 'notify_when_idle'
+  from: string
+  msg_id: string
+  from_mode?: unknown
+}
+
+/** `qtr`: valida a mano el marco `notify_when_idle` (era un esquema zod perezoso). */
+export function parseNotifyWhenIdleFrame(value: unknown): NotifyWhenIdleFrame | undefined {
+  if (typeof value !== 'object' || value === null) return undefined
+  const record = value as Record<string, unknown>
+  if (record.action !== 'notify_when_idle') return undefined
+  if (typeof record.from !== 'string') return undefined
+  if (typeof record.msg_id !== 'string') return undefined
+  return { action: 'notify_when_idle', from: record.from, msg_id: record.msg_id, ...(record.from_mode !== undefined && { from_mode: record.from_mode }) }
+}
+
+export type PeerIdleNoticeFrame = {
+  action: 'peer_idle_notice'
+  orig_msg_id: string
+  state: string
+  finished_at?: unknown
+  detail?: unknown
+  from?: unknown
+  from_mode?: unknown
+}
+
+/** `Ktr`: valida a mano el marco `peer_idle_notice` (era un esquema zod perezoso). */
+export function parsePeerIdleNoticeFrame(value: unknown): PeerIdleNoticeFrame | undefined {
+  if (typeof value !== 'object' || value === null) return undefined
+  const record = value as Record<string, unknown>
+  if (record.action !== 'peer_idle_notice') return undefined
+  if (typeof record.orig_msg_id !== 'string') return undefined
+  if (typeof record.state !== 'string') return undefined
+  return {
+    action: 'peer_idle_notice',
+    orig_msg_id: record.orig_msg_id,
+    state: record.state,
+    ...(record.finished_at !== undefined && { finished_at: record.finished_at }),
+    ...(record.detail !== undefined && { detail: record.detail }),
+    ...(record.from !== undefined && { from: record.from }),
+    ...(record.from_mode !== undefined && { from_mode: record.from_mode }),
+  }
+}
+
+/** `O`: descarta las suscripciones que llevan más de `SUBSCRIPTION_TTL_MS` sin disparar. */
+function pruneExpiredSubscriptions(now: number, host: object = processHost): void {
+  const subscribers = idleState(host).subscribers
+  for (let index = subscribers.length - 1; index >= 0; index--) {
+    if (now - subscribers[index]!.requestedAt > SUBSCRIPTION_TTL_MS) {
+      reportFeatureSad('cross_session_notify_idle', 'expired_unfired')
+      subscribers.splice(index, 1)
+    }
+  }
+}
+
+/** `N`: la tabla de suscripciones está llena. */
+function subscriptionTableFull(): 'full' {
+  reportFeatureSad('cross_session_notify_idle', 'table_full')
+  return 'full'
+}
+
+/** `M`: desaloja una suscripción de su misma clase para hacer sitio a la nueva. */
+function evictSameClassSubscriber(subscribers: IdleSubscriber[], index: number): void {
+  const [evicted] = subscribers.splice(index, 1)
+  if (evicted === undefined) return
+  reportFeatureSad('cross_session_notify_idle', 'evicted_same_class')
+  sendUnavailableNotice(evicted.replyTarget, evicted.origMsgId, evicted.verifiedPeerPid, evicted.authenticated, evicted.verifiedPeerProcStart)
+}
+
+/** `U`: anuncia una suscripción nueva al host, o la deja en espera de que monte un manejador. */
+function announceSubscription(replyAddress: string, hasVerifiedPeerPid: boolean, isReplay = false, host: object = processHost): void {
+  const state = idleState(host)
+  if (state.onSubscribed === null) {
+    if (state.pendingAnnounces.length < SUBSCRIPTION_TABLE_LIMIT) state.pendingAnnounces.push([replyAddress, hasVerifiedPeerPid])
+    else state.pendingAnnounceOverflow++
+    return
+  }
+  try {
+    state.onSubscribed(replyAddress, hasVerifiedPeerPid, isReplay)
+  } catch (error) {
+    state.runtime.reportUncaughtError(error)
+  }
+}
