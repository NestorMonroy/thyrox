+/** `Ytr`: registra o refresca una suscripción de aviso de inactividad. */
+export function subscribeToIdleNotice(
+  replyAddress: string,
+  replyTarget: string,
+  origMsgId: string,
+  verifiedPeerPid: number | undefined,
+  verifiedPeerProcStart: string | undefined,
+  authenticated: boolean,
+  fromMode: EnvelopeMode | undefined,
+  selfSent: boolean,
+  host: object = processHost,
+): SubscribeOutcome {
+  if (!isMessageId(origMsgId)) {
+    reportFeatureSad('cross_session_notify_idle', 'invalid_frame')
+    return 'invalid'
+  }
+  const targetKey = canonicalSocketAddress(replyTarget)
+  if (targetKey === undefined) {
+    reportFeatureSad('cross_session_notify_idle', 'invalid_frame')
+    return 'invalid'
+  }
+  const state = idleState(host)
+  if (state.runtime.localInboundPolicy() === 'refuse') {
+    reportFeatureSad('cross_session_notify_idle', 'refused_by_policy')
+    return 'refused'
+  }
+  if (state.exited) {
+    reportFeatureSad('cross_session_notify_idle', 'subscription_after_exit')
+    return 'full'
+  }
+  pruneExpiredSubscriptions(Date.now(), host)
+  const subscribers = state.subscribers
+  const matchesSamePeer = (candidate: IdleSubscriber) => verifiedPeerPid !== undefined && candidate.targetKey === targetKey && candidate.verifiedPeerPid === verifiedPeerPid
+  const existingIndex = subscribers.findIndex(matchesSamePeer)
+  const alreadyInflight = existingIndex !== -1 || state.inflightBatch.some(matchesSamePeer)
+  const atCapacity = () => subscribers.length >= SUBSCRIPTION_TABLE_LIMIT
+  if (existingIndex !== -1) {
+    subscribers.splice(existingIndex, 1)
+  } else if (verifiedPeerPid !== undefined) {
+    if (countMatching(subscribers, candidate => candidate.verifiedPeerPid === verifiedPeerPid) >= SAME_PID_SUBSCRIBER_LIMIT) {
+      const index = subscribers.findIndex(candidate => candidate.verifiedPeerPid === verifiedPeerPid)
+      if (index === -1) return subscriptionTableFull()
+      evictSameClassSubscriber(subscribers, index)
+    } else if (atCapacity()) return subscriptionTableFull()
+  } else if (!authenticated) {
+    const isUnauthenticatedNoPid = (candidate: IdleSubscriber) => candidate.verifiedPeerPid === undefined && !candidate.authenticated
+    if (countMatching(subscribers, isUnauthenticatedNoPid) >= UNAUTHENTICATED_SUBSCRIBER_LIMIT) {
+      const index = subscribers.findIndex(isUnauthenticatedNoPid)
+      if (index === -1) return subscriptionTableFull()
+      evictSameClassSubscriber(subscribers, index)
+    } else if (atCapacity()) return subscriptionTableFull()
+  } else if (
+    countMatching(subscribers, candidate => candidate.verifiedPeerPid === undefined && candidate.authenticated && candidate.targetKey === targetKey) >= SAME_TARGET_AUTHENTICATED_LIMIT ||
+    atCapacity()
+  ) {
+    return subscriptionTableFull()
+  }
+  subscribers.push({ targetKey, replyTarget, replyAddress, verifiedPeerPid, verifiedPeerProcStart, authenticated, fromMode, selfSent, origMsgId, requestedAt: Date.now() })
+  logForDebugging(
+    `[peer-idle] subscription ${existingIndex === -1 ? 'recorded' : 'refreshed'} for ${withholdTokenText(replyAddress)} (${verifiedPeerPid === undefined ? 'no peer pid' : `pid ${verifiedPeerPid}`}${authenticated ? ', authenticated' : ''}; ${subscribers.length} live)`,
+  )
+  if (!alreadyInflight) announceSubscription(replyAddress, verifiedPeerPid !== undefined, false, host)
+  if (state.idle) scheduleFlush(FLUSH_DEBOUNCE_MS, host)
+  return existingIndex === -1 ? 'recorded' : 'refreshed'
+}
+
+/** `qEn`: el host declara si está inactivo; `sawTurnStart` marca que la ocupación vista era un turno nuevo. */
+export function reportIdleTransition(isIdle: boolean, sawTurnStart: boolean, host: object = processHost): void {
+  const state = idleState(host)
+  if (!isIdle && sawTurnStart) {
+    state.busyObserved = true
+    state.parkedHoldBack = false
+  }
+  if (isIdle === state.idle) return
+  state.idle = isIdle
+  if (isIdle) {
+    if (state.busyObserved) {
+      state.turnEnded = true
+      state.idleSince = Date.now()
+      state.turnConversationId = state.runtime.sessionId()
+      state.busyObserved = false
+    } else if (!state.turnEnded) {
+      state.idleSince = Date.now()
+    }
+    state.parkedHoldBack = state.runtime.heldInboundCount() > 0
+    if (state.subscribers.length > 0) scheduleFlush(FLUSH_DEBOUNCE_MS, host)
+    return
+  }
+  if (state.debounce) {
+    clearTimeout(state.debounce)
+    state.debounce = null
+  }
+}
+
+/** `P`: programa un disparo con debounce, si no hay uno ya pendiente. */
+function scheduleFlush(delay: number = FLUSH_DEBOUNCE_MS, host: object = processHost): void {
+  const state = idleState(host)
+  if (state.debounce) return
+  state.debounce = setTimeout(() => runScheduledFlush(host), delay)
+  state.debounce.unref?.()
+}
+
+/** `Z`: el disparo con debounce, que reintenta si el hilo principal o la entrada retenida no lo dejan. */
+function runScheduledFlush(host: object = processHost): void {
+  const state = idleState(host)
+  state.debounce = null
+  if (!state.idle) return
+  pruneExpiredSubscriptions(Date.now(), host)
+  if (state.subscribers.length === 0) return
+  if (state.runtime.mainThreadQueueLength() > 0) {
+    scheduleFlush(FLUSH_DEBOUNCE_MS, host)
+    return
+  }
+  if (state.runtime.heldInboundCount() > 0) {
+    state.parkedHoldBack = true
+    scheduleFlush(PARKED_RETRY_MS, host)
+    return
+  }
+  state.parkedHoldBack = false
+  const flushing = flushIdleNotices('idle', host).finally(() => {
+    state.inflight.delete(flushing)
+  })
+  state.inflight.add(flushing)
+}
+
+/** `ee`: el detalle de una línea del último turno, si el host lo ofrece. */
+function lastTurnDetail(host: object = processHost): string | undefined {
+  const state = idleState(host)
+  let text = ''
+  try {
+    text = state.getLastTurnText?.() ?? ''
+  } catch (error) {
+    logForDebugging(`[peer-idle] last-turn text unavailable: ${redactLogFragment(String(error))}`)
+  }
+  if (text.trim().length === 0) return undefined
+  let line: string | undefined
+  try {
+    line = state.runtime.classifyTurnStatus(text)?.detail
+  } catch {
+    line = undefined
+  }
+  line ??= text.split('\n').find(candidate => candidate.trim().length > 0)
+  return line === undefined ? undefined : sanitizeIdleLabel(line)
+}
+
+/** `E`: un texto ajeno, listo como etiqueta de una línea de estado. */
+function sanitizeIdleLabel(text: string): string | undefined {
+  let flat = sliceUnits(text, DETAIL_MAX_WIDTH * 8)
+    .replace(/[\p{Cc}\p{Cf}<>«»"[\]]/gu, ' ')
+    .replace(/[\s\p{Z}]+/gu, ' ')
+  for (;;) {
+    const next = flat.replace(/cross-session idle notice/giu, ' ').replace(/ {2,}/g, ' ')
+    if (next === flat) break
+    flat = next
+  }
+  flat = flat.trim()
+  if (flat.length === 0) return undefined
+  return truncateToWidth(flat, DETAIL_MAX_WIDTH)
+}
+
+/** `dqt`: la etiqueta de una sesión, o el texto por omisión si no se pudo sanear. */
+export function fallbackSessionLabel(text: string): string {
+  return sanitizeIdleLabel(text) ?? '(unnamed session)'
+}
+
+/** `Xtr`: registra que esta sesión espera un aviso de `target`, correlacionado por `msgId`. */
+export function registerOutstandingIdleRequest(
+  msgId: string,
+  targetLabelSource: string,
+  target: string,
+  host: object = processHost,
+): { ok: true; priors: string[] } | { ok: false; reason: 'invalid-target' | 'cap' } {
+  const state = idleState(host)
+  const outstanding = state.outstanding
+  const targetKey = canonicalSocketAddress(target)
+  if (targetKey === undefined) return { ok: false, reason: 'invalid-target' }
+  const conversationId = state.runtime.sessionId()
+  for (let index = outstanding.length - 1; index >= 0; index--) {
+    const entry = outstanding[index]!
+    if (entry.conversationId !== conversationId) {
+      clearTimeout(entry.expiry)
+      outstanding.splice(index, 1)
+      reportFeatureSad('cross_session_notify_idle', 'purged_cleared_conversation')
+    }
+  }
+  const sameTarget = outstanding.filter(entry => entry.targetKey === targetKey)
+  while (sameTarget.length > OUTSTANDING_PER_TARGET_LIMIT) {
+    const [victim] = sameTarget.splice(1, 1)
+    if (!victim) break
+    clearTimeout(victim.expiry)
+    outstanding.splice(outstanding.indexOf(victim), 1)
+    reportFeatureSad('cross_session_notify_idle', 'prior_trimmed')
+  }
+  const priors = sameTarget.map(entry => entry.msgId)
+  if (outstanding.length - priors.length >= SUBSCRIPTION_TABLE_LIMIT) return { ok: false, reason: 'cap' }
+  const expiry = setTimeout(() => expireOutstandingRequest(msgId, host), SUBSCRIPTION_TTL_MS)
+  expiry.unref?.()
+  outstanding.push({ msgId, label: fallbackSessionLabel(targetLabelSource), target, targetKey, conversationId, requestedAt: Date.now(), expiry })
+  return { ok: true, priors }
+}
+
+/** `ne`: cuando una petición saliente caduca sin respuesta. */
+function expireOutstandingRequest(msgId: string, host: object = processHost): void {
+  const outstanding = idleState(host).outstanding
+  const index = outstanding.findIndex(entry => entry.msgId === msgId)
+  if (index === -1) return
+  const [entry] = outstanding.splice(index, 1)
+  if (!entry) return
+  if (outstanding.some(candidate => candidate.targetKey === entry.targetKey && candidate.requestedAt > entry.requestedAt)) return
+  for (let index2 = outstanding.length - 1; index2 >= 0; index2--) {
+    const candidate = outstanding[index2]!
+    if (candidate.targetKey === entry.targetKey) {
+      clearTimeout(candidate.expiry)
+      outstanding.splice(index2, 1)
+    }
+  }
+  admitOutstandingExpiry(entry, host)
+}
+
+/** `ie`: admite la caducidad de una petición saliente como una noticia local. */
+function admitOutstandingExpiry(entry: OutstandingIdleRequest, host: object = processHost): void {
+  const sameConversation = entry.conversationId === idleState(host).runtime.sessionId()
+  reportFeatureSad('cross_session_notify_idle', sameConversation ? 'expired_unheard' : 'purged_cleared_conversation')
+  if (sameConversation) dispatchAdmittedNotice({ kind: 'expired', label: entry.label, gate: 'local' }, host)
+}
+
+/** `ibt`: si `msgId` corresponde a una petición saliente todavía viva. */
+export function hasOutstandingIdleRequest(msgId: unknown, host: object = processHost): boolean {
+  return typeof msgId === 'string' && idleState(host).outstanding.some(entry => entry.msgId === msgId)
+}
+
+/** `uqt`: olvida una petición saliente sin admitir ninguna noticia. */
+export function forgetOutstandingIdleRequest(msgId: string, host: object = processHost): void {
+  const outstanding = idleState(host).outstanding
+  const index = outstanding.findIndex(entry => entry.msgId === msgId)
+  if (index === -1) return
+  const [entry] = outstanding.splice(index, 1)
+  if (entry) clearTimeout(entry.expiry)
+}
+
+/** `Jtr`: admite un `peer_idle_notice` ya correlacionado con una petición saliente. */
+export function admitPeerIdleNotice(
+  msgId: unknown,
+  state: unknown,
+  finishedAt: unknown,
+  detail: unknown,
+  fromMode: EnvelopeMode | undefined,
+  selfSent: boolean,
+  host: object = processHost,
+): boolean {
+  if (typeof msgId !== 'string') return false
+  const hostState = idleState(host)
+  const outstanding = hostState.outstanding
+  const index = outstanding.findIndex(entry => entry.msgId === msgId)
+  if (index === -1) return false
+  const [entry] = outstanding.splice(index, 1)
+  if (!entry) return false
+  clearTimeout(entry.expiry)
+  if (state === 'idle' || state === 'exited') {
+    for (let index2 = outstanding.length - 1; index2 >= 0; index2--) {
+      const candidate = outstanding[index2]!
+      if (candidate.targetKey === entry.targetKey) {
+        clearTimeout(candidate.expiry)
+        outstanding.splice(index2, 1)
+      }
+    }
+  }
+  const recognized = state === 'idle' || state === 'exited' || state === 'unavailable'
+  if (!recognized) reportFeatureSad('cross_session_notify_idle', 'notice_state_unrecognized')
+  const kind = recognized ? (state as 'idle' | 'exited' | 'unavailable') : 'unavailable'
+  if (!hostState.runtime.requesterGateEnabled()) {
+    reportFeatureSad('cross_session_notify_idle', 'requester_gate_off')
+    return true
+  }
+  if (entry.conversationId !== hostState.runtime.sessionId()) {
+    reportFeatureSad('cross_session_notify_idle', 'conversation_cleared')
+    return true
+  }
+  if (kind === 'unavailable' && recognized) reportFeatureSad('cross_session_notify_idle', 'peer_unavailable')
+  dispatchAdmittedNotice(
+    {
+      kind,
+      label: entry.label,
+      ...(kind !== 'unavailable' && isPlausibleTimestamp(finishedAt) && { finishedAt }),
+      ...(kind === 'idle' && typeof detail === 'string' && { detail: sanitizeIdleLabel(detail) }),
+      gate: { fromMode, selfSent },
+    } as PendingIdleNotice,
+    host,
+  )
+  return true
+}
+
+/** `te`: la política de entrada decide si la noticia se muestra, y si lleva detalle. */
+function applyInboundNoticePolicy(pending: PendingIdleNotice, host: object = processHost): AdmittedIdleNotice | null {
+  const { gate, ...rest } = pending
+  const runtime = idleState(host).runtime
+  const verdict = gate === 'local' ? runtime.localInboundPolicy() : runtime.inboundPolicyFor(gate)
+  if (verdict === 'refuse') return null
+  const modelVisible = gate === 'local' || verdict === 'accept'
+  return { ...rest, modelVisible } as AdmittedIdleNotice
+}
+
+/** `C`: entrega una noticia admitida al manejador montado, o la deja en el buzón de espera. */
+function dispatchAdmittedNotice(notice: PendingIdleNotice, host: object = processHost): void {
+  const state = idleState(host)
+  if (state.onNotice === null) {
+    if (state.pendingNotices.length < SUBSCRIPTION_TABLE_LIMIT) state.pendingNotices.push({ admitted: notice, conversationId: state.runtime.sessionId() })
+    else state.pendingNoticeOverflow++
+    logForDebugging(`[peer-idle] notice for "${withholdTokenText(notice.label)}" (${notice.kind}) buffered until a host handler mounts`)
+    return
+  }
+  const admitted = applyInboundNoticePolicy(notice, host)
+  if (admitted === null) {
+    reportFeatureSad('cross_session_notify_idle', 'requester_refuses_inbound')
+    return
+  }
+  if (admitted.kind === 'idle' || admitted.kind === 'exited') reportFeatureOk('cross_session_notify_idle')
+  try {
+    state.onNotice(admitted)
+  } catch (error) {
+    state.runtime.reportUncaughtError(error)
+  }
+}
+
+/** `YEn`: monta (o desmonta) el manejador de noticias admitidas, drenando lo que quedó en espera. */
+export function setOnNotice(handler: ((notice: AdmittedIdleNotice) => void) | null, host: object = processHost): void {
+  const state = idleState(host)
+  state.onNotice = handler
+  if (handler === null) return
+  const buffered = state.pendingNotices.splice(0)
+  const overflow = state.pendingNoticeOverflow
+  state.pendingNoticeOverflow = 0
+  const conversationId = state.runtime.sessionId()
+  for (const { admitted, conversationId: bufferedConversationId } of buffered) {
+    if (bufferedConversationId !== conversationId) {
+      reportFeatureSad('cross_session_notify_idle', 'purged_cleared_conversation')
+      continue
+    }
+    dispatchAdmittedNotice(admitted, host)
+  }
+  if (overflow > 0) {
+    logForDebugging(`[peer-idle] ${overflow} notice(s) arrived past the pre-mount buffer and were lost`)
+    reportFeatureSad('cross_session_notify_idle', 'notice_premount_overflow')
+  }
+}
+
+/** `XEn`: fija de dónde sale el texto del último turno. */
+export function setGetLastTurnText(getLastTurnText: (() => string) | null, host: object = processHost): void {
+  idleState(host).getLastTurnText = getLastTurnText
+}
+
+/** `JEn`: fija cómo se envía un aviso; montarlo de nuevo limpia el estado de "salió". */
+export function setSendNotice(sendNotice: SendIdleNotice | null, host: object = processHost): void {
+  const state = idleState(host)
+  if (sendNotice !== null) state.exited = false
+  state.sendNotice = sendNotice
+}
+
+/** `QEn`: monta el manejador de suscripciones nuevas y, opcionalmente, el de fin de reproducción. */
+export function setOnSubscribed(onSubscribed: OnSubscribed | null, onReplayDone: ((overflow: number) => void) | null = null, host: object = processHost): void {
+  const state = idleState(host)
+  state.onSubscribed = onSubscribed
+  state.onReplayDone = onReplayDone
+  if (onSubscribed !== null) {
