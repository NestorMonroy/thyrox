+/** `J`: entrega el lote de suscriptores que el disparo se llevó. */
+async function deliverIdleNotices(hostState: IdleNotificationState, sendNotice: SendIdleNotice, subscribers: IdleSubscriber[], reason: 'idle' | 'exited', effective: string, host: object): Promise<void> {
+  const runtime = hostState.runtime
