+/**
+ * Los argumentos de `new-window` para la ventana separada de un compañero.
+ *
+ * Cierra con la orden de relleno (`SWARM_PANE_PLACEHOLDER_COMMAND`), como el
+ * resto de sitios de creación de panel del backend de tmux: sin ella, la
+ * ventana arranca con un shell que el `send-keys` posterior nunca sustituye.
+ * Exportada para pruebas.
+ */
+export function buildTeammateWindowArgs(
+  sessionName: string,
+  windowName: string,
+): string[] {
+  return [
+    'new-window',
+    '-t',
+    sessionName,
+    '-n',
+    windowName,
+    '-P',
+    '-F',
+    '#{pane_id}',
+    '--',
+    SWARM_PANE_PLACEHOLDER_COMMAND,
+  ]
+}
