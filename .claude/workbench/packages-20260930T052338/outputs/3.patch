+/**
+ * TASK-THYROX-0636 — la ruta `ue` de `chunk-rggb24sh.js` (2.1.283) crea la
+ * ventana separada de un compañero con `new-window … -- ${vFe}`: el panel
+ * arranca con la orden de relleno hasta que el `send-keys` posterior la
+ * sustituye por la orden real. El puerto sólo llevaba la constante; nunca
+ * cerraba el `new-window` con ella.
+ *
+ * Métrica: los argumentos exactos que `buildTeammateWindowArgs` produce.
+ * Ciega a: si un tmux real acepta `-- cat` en `new-window`.
+ */
+import { describe, expect, test } from 'bun:test'
+import { buildTeammateWindowArgs } from '../spawnMultiAgent.js'
+
+describe('buildTeammateWindowArgs', () => {
+  test('cierra con -- cat, como el resto de sitios de creación de panel', () => {
+    expect(buildTeammateWindowArgs('claude-swarm', 'teammate-ana')).toEqual([
+      'new-window',
+      '-t',
+      'claude-swarm',
+      '-n',
+      'teammate-ana',
+      '-P',
+      '-F',
+      '#{pane_id}',
+      '--',
+      'cat',
+    ])
+  })
+
+  test('la sesión y la ventana viajan en su propio sitio, no en el de la otra', () => {
+    const args = buildTeammateWindowArgs('otra-sesion', 'teammate-bea')
+    expect(args[args.indexOf('-t') + 1]).toBe('otra-sesion')
+    expect(args[args.indexOf('-n') + 1]).toBe('teammate-bea')
+  })
+})
