+/** `<registry>/<repositorio>@sha256:<64 hex>`, la forma de `publicationRecord`. */
+const PUBLICATION_REFERENCE = /^([^/@]+)\/([^@]+)@(sha256:[0-9a-f]{64})$/
+
+/** Lo que `locate` lee del registro de publicación. */
