+"""Detector PreToolUse: el controlador que modifica el producto fuera de la excepción.
+
+El defecto que ataja
+--------------------
+La excepción bootstrap del 2026-10-02 (H-THYROX-413) permite que el
+controlador implemente C0 y E0 mientras no exista una ruta local gestionada.
+Cuando la ruta existe, la implementación pasa a los workers gestionados y el
+controlador sólo orquesta, verifica e integra. Sin un gate, nada impide que
+siga escribiendo el producto después de cerrar la excepción, sobre todo tras
+una compactación que la olvide.
+
+Qué decide
+----------
+La política de ejecución declarada (``src/session/execution_policy.json``):
+con ``controller.implementation: managed-only`` niega al controlador escribir
+en una ruta de producto —``src/``, ``tests/`` o ``bin/`` del árbol o de uno de
+sus worktrees de ``.thyrox/runtime/worktrees/``—. Mide las herramientas de
+escritura (``Write``, ``Edit``, ``MultiEdit``, ``NotebookEdit``) y las formas de
+escritura por Bash (``sed -i``, ``replace_literal``, ``gawk -i inplace``,
+``>``/``>>``, ``tee``, ``git apply``, ``cp``, ``mv``, ``rm``). Con
+``bootstrap-exception`` calla.
+
+*Métrica:* la herramienta, más la ruta de destino o los argumentos del comando.
+*Ciega a:* una escritura por un programa que el comando no nombra (un guion
+que escribe por dentro) y al estado (``.claude/``, ``.thyrox/``,
+``agent-results/``), que no es producto y el controlador sigue escribiendo.
+"""
+from __future__ import annotations
+
+import re
+import shlex
+from pathlib import Path
+
+from session.execution_policy import controller_may_implement  # noqa: E402
+
+WRITE_TOOLS = frozenset({"Write", "Edit", "MultiEdit", "NotebookEdit"})
+
+#: Las formas de escribir un archivo desde Bash.
+_BASH_WRITE = re.compile(
+    r"\bsed\s+(?:-\w*\s+)*-i\b|\breplace_literal\b|\bgawk\s+-i\s+inplace\b|>>?|\btee\b"
+    r"|\bgit\s+apply\b|\b(?:cp|mv|rm)\s")
+
+_PRODUCT_TOP = ("src", "tests", "bin")
+_ROOT = Path(__file__).resolve().parents[2]
+_WORKTREE = re.compile(r"/\.thyrox/runtime/worktrees/[^/]+/(?:src|tests|bin)/")
+
+POLICY_DENY_NOTICE = (
+    "POLÍTICA DE EJECUCIÓN — la política declarada (`controller.implementation: "
+    "managed-only`, `src/session/execution_policy.json`) cerró la excepción bootstrap: "
+    "el controlador orquesta, verifica e integra, pero no escribe el producto. La "
+    "implementación va a un worker gestionado (`bin/headless-pool --isolation worktree` "
+    "o `bin/task_continuation`) y se integra con `bin/pool_integrate`."
+)
+
+
+def is_product_path(text: str) -> bool:
+    """¿Nombra el texto una ruta de producto del árbol o de uno de sus worktrees?"""
+    path = text.strip("\"'")
+    if path.startswith(tuple(f"{top}/" for top in _PRODUCT_TOP)):
+        return True
+    if any(path.startswith(f"{_ROOT}/{top}/") for top in _PRODUCT_TOP):
+        return True
+    return bool(_WORKTREE.search(path))
+
+
+def _tokens(command: str) -> list[str]:
+    try:
+        return shlex.split(command, comments=False, posix=True)
+    except ValueError:
+        return command.split()
+
+
+def mutated_product_path(payload: dict) -> str | None:
+    """La ruta de producto que la llamada escribiría, o ``None``."""
+    tool = payload.get("tool_name")
+    tool_input = payload.get("tool_input") or {}
+    if tool in WRITE_TOOLS:
+        path = tool_input.get("file_path") or tool_input.get("notebook_path") or ""
+        return path if isinstance(path, str) and is_product_path(path) else None
+    if tool == "Bash":
+        command = tool_input.get("command")
+        if not isinstance(command, str) or not _BASH_WRITE.search(command):
+            return None
+        return next((token for token in _tokens(command) if is_product_path(token.lstrip(">"))), None)
+    return None
+
+
+def detect(payload: dict) -> dict | None:
+    """La negación si el controlador escribe el producto fuera de la excepción."""
+    path = mutated_product_path(payload)
+    if path is None or controller_may_implement():
+        return None
+    return {"notice": f"{POLICY_DENY_NOTICE} Destino: {path}", "decision": "deny"}
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import json
+    import sys
+
+    result = detect(json.load(sys.stdin))
+    if result:
+        print(json.dumps(result))
+    raise SystemExit(0)
