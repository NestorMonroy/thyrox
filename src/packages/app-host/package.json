{
  "name": "@thyrox/app-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "El host de la sesion interactiva: el grafo de runtime handles, el ciclo de instalacion de bindings y los selectores de AppState. Adaptacion de @claude-code-how-works/app-host, capa 0 (sin cita a paquete hermano).",
  "main": "./src/index.ts",
