{
  "name": "@thyrox/app-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "El host de la sesion interactiva: el grafo de runtime handles, el ciclo de instalacion de bindings y los selectores de AppState. Adaptacion de @claude-code-how-works/app-host. Depende de @thyrox/command-runtime, @thyrox/config, @thyrox/shell y @thyrox/storage para los especificadores de @claude-code-how-works/* que ya resuelven contra un hermano portado (TASK-DOCS-0198).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@thyrox/command-runtime": "workspace:*",
    "@thyrox/config": "workspace:*",
    "@thyrox/shell": "workspace:*",
    "@thyrox/storage": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./runtime/*.js": "./src/runtime/*.ts",
    "./main/*.js": "./src/main/*.ts",
    "./cliArgs.js": "./src/cliArgs.ts",
    "./activityManager.js": "./src/activityManager.ts",
    "./state/sessionSelectors.js": "./src/state/sessionSelectors.ts",
    "./state/hostSessionState.js": "./src/state/hostSessionState.ts",
    "./state/AppStateStore.js": "./src/state/AppStateStore.ts",
    "./state/uiSelectors.js": "./src/state/uiSelectors.ts",
    "./state/pluginSelectors.js": "./src/state/pluginSelectors.ts",
    "./state/teamSelectors.js": "./src/state/teamSelectors.ts",
    "./state/taskSelectors.js": "./src/state/taskSelectors.ts",
    "./state/permissionSelectors.js": "./src/state/permissionSelectors.ts",
    "./state/mcpSelectors.js": "./src/state/mcpSelectors.ts"
  },
  "scripts": {
    "test": "bun test"
  }
}
