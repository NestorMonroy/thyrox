    "./state/sessionSelectors.js": "./src/state/sessionSelectors.ts",
    "./state/hostSessionState.js": "./src/state/hostSessionState.ts",
    "./state/AppStateStore.js": "./src/state/AppStateStore.ts",
    "./state/uiSelectors.js": "./src/state/uiSelectors.ts",
    "./state/pluginSelectors.js": "./src/state/pluginSelectors.ts",
    "./state/teamSelectors.js": "./src/state/teamSelectors.ts",
    "./state/taskSelectors.js": "./src/state/taskSelectors.ts",
    "./state/permissionSelectors.js": "./src/state/permissionSelectors.ts",
    "./state/mcpSelectors.js": "./src/state/mcpSelectors.ts"
  },
  "scripts": {
    "test": "bun test"
  }
