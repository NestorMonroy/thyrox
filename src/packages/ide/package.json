{
  "name": "@thyrox/ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Porte de @claude-code-how-works/ide (ccnmt): adaptadores de integracion IDE (VS Code/JetBrains) + cliente LSP. 19 de 19 modulos fuente portados (contando indice y stubs); ver internal/pendingCrossPackageDeps.ts para las dependencias cruzadas resueltas por require() diferido (paquete no registrado todavia en src/packages/package.json:workspaces) y las reimplementaciones fieles recortadas de simbolos que no existen aun en ningun paquete hermano (tool-registry entero; agent/jetbrains.ts; agent/diff.ts:getPatchFromContents/getPatchForDisplay; shell/genericProcessUtils.ts; config/plugin/{lspPluginIntegration,pluginLoader,types}.ts; config/env/paths.ts; config/semver.ts). callIdeRpc (mcp-runtime/clientRuntime.ts) queda como punto de inyeccion: ese modulo esta bloqueado dentro del propio mcp-runtime (13/48 simbolos, por ausencia de tool-registry).",
  "main": "./src/index.ts",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./src/contracts.ts"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./src/errors.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./testing/index.ts"
    },
    "./ide.js": {
      "types": "./dist/src/ide.d.ts",
      "default": "./src/ide.ts"
    },
    "./hooks/useIDEIntegration": {
      "types": "./dist/src/hooks/useIDEIntegration.d.ts",
      "default": "./src/hooks/useIDEIntegration.tsx"
    },
    "./hooks/useIDEIntegration.js": {
      "types": "./dist/src/hooks/useIDEIntegration.d.ts",
      "default": "./src/hooks/useIDEIntegration.tsx"
    },
    "./hooks/useDiffInIDE.js": {
      "types": "./dist/src/hooks/useDiffInIDE.d.ts",
      "default": "./src/hooks/useDiffInIDE.ts"
    },
    "./hooks/useIdeAtMentioned.js": {
      "types": "./dist/src/hooks/useIdeAtMentioned.d.ts",
      "default": "./src/hooks/useIdeAtMentioned.ts"
    },
    "./hooks/useIdeConnectionStatus.js": {
      "types": "./dist/src/hooks/useIdeConnectionStatus.d.ts",
      "default": "./src/hooks/useIdeConnectionStatus.ts"
    },
    "./hooks/useIdeLogging.js": {
      "types": "./dist/src/hooks/useIdeLogging.d.ts",
      "default": "./src/hooks/useIdeLogging.ts"
    },
    "./hooks/useIdeSelection.js": {
      "types": "./dist/src/hooks/useIdeSelection.d.ts",
      "default": "./src/hooks/useIdeSelection.ts"
    },
    "./lsp/LSPDiagnosticRegistry.js": {
      "types": "./dist/src/lsp/LSPDiagnosticRegistry.d.ts",
      "default": "./src/lsp/LSPDiagnosticRegistry.ts"
    },
    "./lsp/manager.js": {
      "types": "./dist/src/lsp/manager.d.ts",
      "default": "./src/lsp/manager.ts"
    }
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@thyrox/agent": "workspace:*",
    "@thyrox/app-host": "workspace:*",
    "@thyrox/config": "workspace:*",
    "@thyrox/local-observability": "workspace:*",
    "@thyrox/mcp-runtime": "workspace:*",
    "@thyrox/permission": "workspace:*",
    "@thyrox/repl": "workspace:*",
    "@thyrox/shell": "workspace:*",
    "@thyrox/storage": "workspace:*",
    "@thyrox/tool-registry": "workspace:*",
    "axios": "^1.20.0",
    "diff": "^7.0.0",
    "execa": "^9.0.0",
    "lru-cache": "^11.0.0",
    "react": "^19.0.0",
    "vscode-jsonrpc": "^8.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/react": "^19.0.0",
    "vscode-languageserver-protocol": "^3.17.5"
  }
}
