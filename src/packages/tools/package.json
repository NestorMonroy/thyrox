{
  "name": "@thyrox/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "El registro de herramientas y las herramientas mismas: las seis del nucleo, el despacho de subagentes con sus definiciones, plan, skill, tareas y web.",
  "exports": {
    "./registry": {
      "@thyrox/source": "./src/registry.ts",
      "types": "./dist/registry.d.ts",
      "default": "./src/registry.ts"
    },
    "./agent": {
      "@thyrox/source": "./src/agent.ts",
      "types": "./dist/agent.d.ts",
      "default": "./src/agent.ts"
    },
    "./agentDefinitions": {
      "@thyrox/source": "./src/agentDefinitions.ts",
      "types": "./dist/agentDefinitions.d.ts",
      "default": "./src/agentDefinitions.ts"
    },
    "./plan": {
      "@thyrox/source": "./src/plan.ts",
      "types": "./dist/plan.d.ts",
      "default": "./src/plan.ts"
    },
    "./skill": {
      "@thyrox/source": "./src/skill.ts",
      "types": "./dist/skill.d.ts",
      "default": "./src/skill.ts"
    },
    "./tasks": {
      "@thyrox/source": "./src/tasks.ts",
      "types": "./dist/tasks.d.ts",
      "default": "./src/tasks.ts"
    },
    "./web": {
      "@thyrox/source": "./src/web.ts",
      "types": "./dist/web.d.ts",
      "default": "./src/web.ts"
    },
    "./definitions": {
      "@thyrox/source": "./src/definitions/index.ts",
      "types": "./dist/definitions/index.d.ts",
      "default": "./src/definitions/index.ts"
    },
    "./definitions/rupCoordinator": {
      "@thyrox/source": "./src/definitions/rupCoordinator.ts",
      "types": "./dist/definitions/rupCoordinator.d.ts",
      "default": "./src/definitions/rupCoordinator.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@thyrox/provider": "0.1.0"
  },
  "dependencies": {
    "@thyrox/agent": "0.4.0",
    "@thyrox/observability": "0.1.0",
    "@thyrox/plan": "0.1.0",
    "@thyrox/skills": "0.1.0",
    "@thyrox/task": "0.1.0",
    "@thyrox/store": "0.1.0"
  }
}
