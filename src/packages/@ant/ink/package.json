{
  "name": "@anthropic/ink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./keybindings": {
      "types": "./dist/keybindings/index.d.ts",
      "default": "./src/keybindings/index.ts"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "default": "./src/search/index.ts"
    },
    "./vim": {
      "types": "./dist/vim/index.d.ts",
      "default": "./src/vim/index.ts"
    }
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.1.3",
    "@thyrox/local-observability": "workspace:*",
    "@thyrox/output": "workspace:*",
    "@thyrox/repl": "workspace:*",
    "auto-bind": "^5.0.1",
    "bidi-js": "^1.0.3",
    "chalk": "^5.6.2",
    "cli-boxes": "^4.0.1",
    "code-excerpt": "^4.0.0",
    "emoji-regex": "^10.6.0",
    "figures": "^6.1.0",
    "get-east-asian-width": "^1.5.0",
    "indent-string": "^5.0.0",
    "lodash-es": "^4.17.23",
    "react": "^19.2.4",
    "react-reconciler": "^0.33.0",
    "semver": "^7.8.5",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.4.0",
    "type-fest": "^5.5.0",
    "usehooks-ts": "^3.1.1",
    "wrap-ansi": "^10.0.0"
  }
}
