{
  "name": "@thyrox/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Porte parcial del paquete cli de claude-code-nestor-monroy-tools (TASK-DOCS-0205), mas el hogar de la CLI del harness (#226 tramos 6 y 7): el binario bin/harness.ts, el dibujo del flujo de eventos (render.ts), el selector de reanudacion (resume.ts) y el selector de pruebas por impacto (testing/). La dependencia de @thyrox/harness sobrevive por UNA cita, la del workbench superado, cuyo retiro es un pase propio (#266, h-docs-1142).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./exitCodes.js": "./src/exitCodes.ts",
    "./argv.js": "./src/argv.ts",
    "./print": "./src/print.ts",
    "./secureStorage/keychainPrefetch": "./src/secureStorage/keychainPrefetch.ts",
    "./structuredIOHelper": "./src/structuredIOHelper.ts",
    "./*": "./src/*.ts",
    "./*.js": "./src/*.ts",
    "./render": "./src/render.ts",
    "./resume": "./src/resume.ts",
    "./testing/impact": "./src/testing/impact.ts",
    "./testing/io": "./src/testing/io.ts"
  },
  "scripts": {
    "test": "bun test",
    "harness": "bun run bin/harness.ts"
  },
  "dependencies": {
    "@thyrox/agent": "workspace:*",
    "@thyrox/app-host": "workspace:*",
    "@thyrox/config": "workspace:*",
    "@thyrox/harness": "workspace:*",
    "@thyrox/headless-sdk": "workspace:*",
    "@thyrox/local-observability": "workspace:*",
    "@thyrox/mcp-runtime": "workspace:*",
    "@thyrox/observability": "workspace:*",
    "@thyrox/permission": "workspace:*",
    "@thyrox/provider": "workspace:*",
    "@thyrox/skills": "workspace:*",
    "@thyrox/tools": "workspace:*"
  }
}
