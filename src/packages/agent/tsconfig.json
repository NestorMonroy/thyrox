{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "bun"
    ]
  },
  "include": [
    "loop/**/*.ts",
    "compaction/**/*.ts"
  ],
  "files": [
    "../cli/src/types/global.d.ts",
    "../@ant/ink/src/types/ink-jsx.d.ts",
    "../@ant/ink/src/types/ink-elements.d.ts"
  ]
}
