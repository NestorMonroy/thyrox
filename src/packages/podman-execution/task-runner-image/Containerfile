# Imagen de ejecución de las tareas de thyrox (ADR-THYROX-007, enmienda
# 1.16.0): las herramientas con que una ExecutionUnit crea un banco, edita,
# instala, compila, prueba y commitea sobre el repositorio montado. El
# anfitrión no aporta ninguna.
#
# La base es la misma Ubuntu 24.04 del anfitrión para que el `.venv` del
# repositorio, que enlaza a /usr/bin/python3.12, resuelva igual dentro.
ARG BASE_IMAGE=docker.io/library/ubuntu:24.04
FROM ${BASE_IMAGE}
# Proxy de salida y su CA, sólo durante la construcción.
ARG HTTPS_PROXY
ARG https_proxy
ARG PROXY_CA
ARG BUN_VERSION=1.3.11
ARG UV_VERSION=0.8.17
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash coreutils findutils git gawk jq python3 python3-venv \
      sqlite3 ripgrep parallel time procps ca-certificates curl unzip xz-utils file \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL --cacert "$PROXY_CA" -o /tmp/bun.zip "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" \
 && unzip -q /tmp/bun.zip -d /tmp \
 && install -m 0755 /tmp/bun-linux-x64/bun /usr/local/bin/bun \
 && ln -s bun /usr/local/bin/bunx \
 && rm -rf /tmp/bun.zip /tmp/bun-linux-x64
RUN curl -fsSL --cacert "$PROXY_CA" -o /tmp/uv.tgz "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
 && tar -xzf /tmp/uv.tgz -C /tmp \
 && install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uv /tmp/uv-x86_64-unknown-linux-gnu/uvx /usr/local/bin/ \
 && rm -rf /tmp/uv.tgz /tmp/uv-x86_64-unknown-linux-gnu
