{
  "name": "@thyrox/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistencia en disco: rutas, archivos temporales, XDG y conversion Windows/POSIX. Adaptacion de @claude-code-how-works/storage (ccnmt) \u2014 porte parcial, ver docstrings por modulo.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./cache-paths": {
      "types": "./dist/cache-paths.d.ts",
      "default": "./src/cache-paths.ts"
    },
    "./tempfile.js": {
      "types": "./dist/tempfile.d.ts",
      "default": "./src/tempfile.ts"
    },
    "./path.js": {
      "types": "./dist/path.d.ts",
      "default": "./src/path.ts"
    },
    "./windowsPaths.js": {
      "types": "./dist/windowsPaths.d.ts",
      "default": "./src/windowsPaths.ts"
    },
    "./xdg.js": {
      "types": "./dist/xdg.d.ts",
      "default": "./src/xdg.ts"
    },
    "./glob.js": {
      "types": "./dist/glob.d.ts",
      "default": "./src/glob.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./src/testing/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "cli": "bun run bin/storage.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@thyrox/agent": "workspace:*",
    "@thyrox/app-host": "workspace:*",
    "@thyrox/cli": "workspace:*",
    "@thyrox/command-runtime": "workspace:*",
    "@thyrox/config": "workspace:*",
    "@thyrox/local-observability": "workspace:*",
    "@thyrox/output": "workspace:*",
    "@thyrox/permission": "workspace:*",
    "@thyrox/provider": "workspace:*",
    "@thyrox/shell": "workspace:*",
    "@thyrox/tool-registry": "workspace:*",
    "env-paths": "^4.0.0",
    "ignore": "^7.0.8",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.18.1",
    "picomatch": "^4.0.7",
    "proper-lockfile": "^4.1.2"
  },
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts"
}
