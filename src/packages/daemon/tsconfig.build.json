{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "skipLibCheck": true,
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "bun"
    ],
    "preserveSymlinks": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@thyrox/daemon": [
        "./src/index.ts"
      ],
      "@thyrox/daemon/contracts": [
        "./src/contracts.ts"
      ],
      "@thyrox/daemon/errors": [
        "./src/errors.ts"
      ],
      "@thyrox/daemon/testing": [
        "./testing/index.ts"
      ],
      "@thyrox/daemon/bgWorkerRegistry.js": [
        "./src/bgWorkerRegistry.ts"
      ],
      "@thyrox/daemon/daemonClient.js": [
        "./src/daemonClient.ts"
      ],
      "@thyrox/daemon/dispatchSpool.js": [
        "./src/dispatchSpool.ts"
      ],
      "@thyrox/daemon/launchAgent.js": [
        "./src/launchAgent.ts"
      ],
      "@thyrox/daemon/main.js": [
        "./src/main.ts"
      ],
      "@thyrox/daemon/socketProto.js": [
        "./src/socketProto.ts"
      ],
      "@thyrox/daemon/workerRegistry.js": [
        "./src/workerRegistry.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "testing/**/*"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "node_modules",
    "dist"
  ],
  "files": [
    "../../types/build-globals.d.ts"
  ]
}
