{
  "name": "@thyrox/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proceso supervisor de larga vida: registro de workers, IPC, ciclo de vida. Puerto de claude-code-nestor-monroy-tools (packages/daemon). No es miembro del bun workspace (src/packages/package.json) todavia; sus cruces a @thyrox/{local-observability,provider,shell,cli,agent} viven como puntos de inyeccion / reimplementaciones fieles en src/internal/pendingCrossPackageDeps.ts (ver ese archivo para la cita completa de origen).",
  "main": "./src/index.ts",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./src/contracts.ts"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./src/errors.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./testing/index.ts"
    },
    "./bgWorkerRegistry.js": {
      "types": "./dist/src/bgWorkerRegistry.d.ts",
      "default": "./src/bgWorkerRegistry.ts"
    },
    "./daemonClient.js": {
      "types": "./dist/src/daemonClient.d.ts",
      "default": "./src/daemonClient.ts"
    },
    "./dispatchSpool.js": {
      "types": "./dist/src/dispatchSpool.d.ts",
      "default": "./src/dispatchSpool.ts"
    },
    "./launchAgent.js": {
      "types": "./dist/src/launchAgent.d.ts",
      "default": "./src/launchAgent.ts"
    },
    "./main.js": {
      "types": "./dist/src/main.d.ts",
      "default": "./src/main.ts"
    },
    "./socketProto.js": {
      "types": "./dist/src/socketProto.d.ts",
      "default": "./src/socketProto.ts"
    },
    "./workerRegistry.js": {
      "types": "./dist/src/workerRegistry.d.ts",
      "default": "./src/workerRegistry.ts"
    }
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@thyrox/agent": "workspace:*"
  }
}
