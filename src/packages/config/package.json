{
  "name": "@thyrox/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "La capa de configuracion: esquema de settings, precedencia de fuentes y validacion. Lo que el harness y el tooling leen en vez de parsear JSON a mano.",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./types": "./settings/types.ts",
    "./constants": "./settings/constants.ts",
    "./validation": "./settings/validation.ts",
    "./load": "./settings/load.ts",
    "./settings": "./settings/settings.ts",
    "./env": "./env/index.ts",
    "./env/utils": "./env/utils.ts",
    "./remote": "./remote/index.ts",
    "./*": "./*.ts",
    "./*.js": "./*.ts",
    "./plugin/core/performStartupChecks.js": "./plugin/core/performStartupChecks.tsx"
  },
  "scripts": {
    "test": "bun test",
    "settings": "bun run bin/settings.ts"
  },
  "dependencies": {
    "@anthropic/ink": "workspace:*",
    "@thyrox/agent": "workspace:*",
    "@thyrox/app-host": "workspace:*",
    "@thyrox/bridge": "workspace:*",
    "@thyrox/command-runtime": "workspace:*",
    "@thyrox/local-observability": "workspace:*",
    "@thyrox/memory": "workspace:*",
    "@thyrox/output": "workspace:*",
    "@thyrox/permission": "workspace:*",
    "@thyrox/provider": "workspace:*",
    "@thyrox/repl": "workspace:*",
    "@thyrox/shell": "workspace:*",
    "@thyrox/storage": "workspace:*",
    "@thyrox/updater": "workspace:*",
    "axios": "^1.20.0",
    "lodash-es": "^4.18.1",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/proper-lockfile": "^4.1.4"
  }
}
