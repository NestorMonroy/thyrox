{
  "name": "@thyrox/observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lo que el bucle registra sobre si mismo: journal, costo por turno, la fila de sesion en el store, la forma del transcript y los resultados limpiados.",
  "exports": {
    "./journal": {
      "@thyrox/source": "./src/journal.ts",
      "types": "./dist/journal.d.ts",
      "default": "./src/journal.ts"
    },
    "./cost": {
      "@thyrox/source": "./src/cost.ts",
      "types": "./dist/cost.d.ts",
      "default": "./src/cost.ts"
    },
    "./store": {
      "@thyrox/source": "./src/store.ts",
      "types": "./dist/store.d.ts",
      "default": "./src/store.ts"
    },
    "./transcriptShape": {
      "@thyrox/source": "./src/transcriptShape.ts",
      "types": "./dist/transcriptShape.d.ts",
      "default": "./src/transcriptShape.ts"
    },
    "./clearedResults": {
      "@thyrox/source": "./src/clearedResults.ts",
      "types": "./dist/clearedResults.d.ts",
      "default": "./src/clearedResults.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  },
  "dependencies": {
    "@thyrox/agent": "0.4.0",
    "@thyrox/paths": "0.1.0",
    "@thyrox/store": "0.1.0"
  }
}
