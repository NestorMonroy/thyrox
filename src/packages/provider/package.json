{
  "name": "@thyrox/provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "La interfaz del modelo y sus dos adaptadores: HTTP a Anthropic (SSE) y el grabado que reproduce respuestas. Lo que el bucle LLAMA para obtener un turno.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./anthropicHttp": {
      "types": "./dist/anthropicHttp.d.ts",
      "default": "./src/anthropicHttp.ts"
    },
    "./recorded": {
      "types": "./dist/recorded.d.ts",
      "default": "./src/recorded.ts"
    },
    "./anthropicMockServer": {
      "types": "./dist/anthropicMockServer.d.ts",
      "default": "./src/anthropicMockServer.ts"
    },
    "./sse": {
      "types": "./dist/sse.d.ts",
      "default": "./src/sse.ts"
    },
    "./caCerts": {
      "types": "./dist/internal/caCerts.d.ts",
      "default": "./src/internal/caCerts.ts"
    },
    "./gemini": {
      "types": "./dist/gemini/index.d.ts",
      "default": "./src/gemini/index.ts"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./src/openai/index.ts"
    },
    "./policyLimits": {
      "types": "./dist/policyLimits/index.d.ts",
      "default": "./src/policyLimits/index.ts"
    },
    "./cost/*": {
      "types": "./dist/cost/*.d.ts",
      "default": "./src/cost/*.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    },
    "./commands/logout/logout.js": {
      "types": "./dist/commands/logout/logout.d.ts",
      "default": "./src/commands/logout/logout.tsx"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@anthropic/ink": "workspace:*",
    "@thyrox/agent": "workspace:*",
    "@thyrox/app-host": "workspace:*",
    "@thyrox/bridge": "workspace:*",
    "@thyrox/command-runtime": "workspace:*",
    "@thyrox/config": "workspace:*",
    "@thyrox/headless-sdk": "workspace:*",
    "@thyrox/local-observability": "workspace:*",
    "@thyrox/mcp-runtime": "workspace:*",
    "@thyrox/output": "workspace:*",
    "@thyrox/permission": "workspace:*",
    "@thyrox/repl": "workspace:*",
    "@thyrox/shell": "workspace:*",
    "@thyrox/storage": "workspace:*",
    "@thyrox/teleport": "workspace:*",
    "@thyrox/tool-registry": "workspace:*",
    "axios": "^1.20.0",
    "chalk": "^6.0.0",
    "https-proxy-agent": "^5.0.1",
    "lodash-es": "^4.18.1",
    "openai": "6.33.0",
    "selfsigned": "^5.5.0",
    "zod": "^4.3.6"
  },
  "types": "./dist/index.d.ts"
}
