{
  "name": "@thyrox/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Porte parcial del paquete shell de claude-code-nestor-monroy-tools: 54 de 90 modulos de la fuente. Cubre heredocs de bash, specs Fig (carga + registro completo), deteccion/citado/quoting de shell, proveedores de PowerShell (DI y legacy), limites de salida, resolucion de shell por defecto, gate de PowerShellTool, contextos de inyeccion (ShellExecContext/SnapshotContext), tipos transversales, errores tipados, backup de preferencias de terminal (iTerm2/Terminal.app), resolucion de ripgrep para sandbox, stubs de testing, y las utilidades de proceso ya presentes (execFileNoThrow, which, subprocessEnv). El nucleo de parseo de bash (ast.ts/bashParser.ts/commands.ts/parser.ts), el motor de sandbox (sandbox-adapter.ts) y el aislamiento de tmux (tmuxSocket.ts) siguen sin portar por su tamano y su acoplamiento mutuo (~13000 lineas combinadas) — ver los docstrings de los modulos que dependen de ellos.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./process.js": "./src/process.ts",
    "./subprocessEnv.js": "./src/subprocessEnv.ts",
    "./bash/heredoc.js": "./src/bash/heredoc.ts",
    "./bash/registry.js": "./src/bash/registry.ts",
    "./bash/shellPrefix.js": "./src/bash/shellPrefix.ts",
    "./bash/shellQuote.js": "./src/bash/shellQuote.ts",
    "./bash/shellQuoting.js": "./src/bash/shellQuoting.ts",
    "./bash/internal.js": "./src/bash/internal.ts",
    "./bash/unicodeDashes.js": "./src/bash/unicodeDashes.ts",
    "./bash/specs/index.js": "./src/bash/specs/index.ts",
    "./execFileNoThrow.js": "./src/execFileNoThrow.ts",
    "./execFileNoThrowPortable.js": "./src/execFileNoThrowPortable.ts",
    "./genericProcessUtils.js": "./src/genericProcessUtils.ts",
    "./which.js": "./src/which.ts",
    "./errors.js": "./src/errors.ts",
    "./types.js": "./src/types.ts",
    "./context.js": "./src/context.ts",
    "./findExecutable.js": "./src/findExecutable.ts",
    "./immediateCommand.js": "./src/immediateCommand.ts",
    "./commandLifecycle.js": "./src/commandLifecycle.ts",
    "./taskOutputPort.js": "./src/taskOutputPort.ts",
    "./execSyncWrapper.js": "./src/execSyncWrapper.ts",
    "./sandboxUiUtils.js": "./src/sandboxUiUtils.ts",
    "./sandbox/sandboxRipgrepResolver.js": "./src/sandbox/sandboxRipgrepResolver.ts",
    "./terminal/iTermBackup.js": "./src/terminal/iTermBackup.ts",
    "./terminal/appleTerminalBackup.js": "./src/terminal/appleTerminalBackup.ts",
    "./providers/outputLimits.js": "./src/providers/outputLimits.ts",
    "./providers/resolveDefaultShell.js": "./src/providers/resolveDefaultShell.ts",
    "./providers/shellToolUtils.js": "./src/providers/shellToolUtils.ts",
    "./providers/shellProvider.js": "./src/providers/shellProvider.ts",
    "./providers/powershellDetection.js": "./src/providers/powershellDetection.ts",
    "./providers/powershellProvider.js": "./src/providers/powershellProvider.ts",
    "./legacy/outputLimits.js": "./src/legacy/outputLimits.ts",
    "./legacy/resolveDefaultShell.js": "./src/legacy/resolveDefaultShell.ts",
    "./legacy/shellToolUtils.js": "./src/legacy/shellToolUtils.ts",
    "./legacy/shellProvider.js": "./src/legacy/shellProvider.ts",
    "./legacy/powershellDetection.js": "./src/legacy/powershellDetection.ts",
    "./legacy/powershellProvider.js": "./src/legacy/powershellProvider.ts",
    "./testing": "./src/testing/index.ts",
    "./testing.js": "./src/testing/index.ts",
    "./*": "./src/*.ts",
    "./*.js": "./src/*.ts"
  },
  "scripts": {
    "test": "bun test",
    "shell": "bun run bin/shell.ts"
  },
  "dependencies": {
    "@thyrox/config": "workspace:*",
    "@thyrox/local-observability": "workspace:*",
    "@thyrox/storage": "workspace:*"
  }
}
