{
  "name": "@thyrox/skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "El registro de skills, su lectura desde un directorio y las que viajan con el arbol. Lo que la herramienta Skill consulta.",
  "exports": {
    "./registry": {
      "@thyrox/source": "./src/registry.ts",
      "types": "./dist/registry.d.ts",
      "default": "./src/registry.ts"
    },
    "./fromDir": {
      "@thyrox/source": "./src/fromDir.ts",
      "types": "./dist/fromDir.d.ts",
      "default": "./src/fromDir.ts"
    },
    "./bundled": {
      "@thyrox/source": "./src/bundled.ts",
      "types": "./dist/bundled.d.ts",
      "default": "./src/bundled.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  },
  "dependencies": {
    "@thyrox/agent": "workspace:*",
    "@thyrox/paths": "workspace:*"
  }
}
