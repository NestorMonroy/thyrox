{
  "name": "@thyrox/memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./testing/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./src/*.ts"
    },
    "./*.js": {
      "types": "./dist/src/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@thyrox/config": "workspace:*",
    "@thyrox/local-observability": "workspace:*",
    "axios": "^1.20.0",
    "zod": "^4.3.6"
  }
}
