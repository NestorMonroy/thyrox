{
  "name": "@thyrox/task",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Esquema, E/S y premisas del registro de tareas.",
  "exports": {
    ".": {
      "@thyrox/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./index.ts"
    },
    "./*.ts": {
      "@thyrox/source": "./*.ts",
      "types": "./dist/*.d.ts",
      "default": "./*.ts"
    }
  },
  "dependencies": {
    "@thyrox/paths": "0.1.0"
  },
  "types": "./dist/index.d.ts"
}
