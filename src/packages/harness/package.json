{
  "name": "@thyrox/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "El harness propio: el bucle que llama al modelo, atiende sus llamadas a herramienta y decide cuando parar.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./transcript": "./src/transcript.ts",
    "./session": "./src/session.ts",
    "./hooks": "./src/hooks.ts",
    "./loop": "./src/loop.ts",
    "./context/systemPrompt": "./src/context/systemPrompt.ts",
    "./context/microcompact": "./src/context/microcompact.ts",
    "./context/autocompact": "./src/context/autocompact.ts",
    "./sessions": "./src/sessions/index.ts",
    "./sessions/modelSwitch": "./src/sessions/modelSwitch.ts",
    "./cli/render": "./src/cli/render.ts",
    "./cli/resume": "./src/cli/resume.ts",
    "./session/reconcile": "./src/session/reconcile.ts"
  },
  "scripts": {
    "test": "bun test",
    "harness": "bun run bin/harness.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  },
  "dependencies": {
    "@thyrox/agent": "workspace:*",
    "@thyrox/config": "workspace:*",
    "@thyrox/observability": "workspace:*",
    "@thyrox/permission": "workspace:*",
    "@thyrox/provider": "workspace:*",
    "@thyrox/skills": "workspace:*",
    "@thyrox/tools": "workspace:*"
  }
}
