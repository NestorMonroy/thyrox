{
  "name": "@thyrox/teleport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./dist/src/contracts.d.ts",
      "default": "./src/contracts.ts"
    },
    "./errors": {
      "types": "./dist/src/errors.d.ts",
      "default": "./src/errors.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./testing/index.ts"
    },
    "./remote-setup": {
      "types": "./dist/src/remote-setup/index.d.ts",
      "default": "./src/remote-setup/index.ts"
    },
    "./remote-setup/remote-setup": {
      "types": "./dist/src/remote-setup/remote-setup.d.ts",
      "default": "./src/remote-setup/remote-setup.tsx"
    },
    "./api.js": {
      "types": "./dist/src/api.d.ts",
      "default": "./src/api.ts"
    },
    "./environmentSelection.js": {
      "types": "./dist/src/environmentSelection.d.ts",
      "default": "./src/environmentSelection.ts"
    },
    "./environments.js": {
      "types": "./dist/src/environments.d.ts",
      "default": "./src/environments.ts"
    },
    "./gitBundle.js": {
      "types": "./dist/src/gitBundle.d.ts",
      "default": "./src/gitBundle.ts"
    },
    "./remote-setup/index.js": {
      "types": "./dist/src/remote-setup/index.d.ts",
      "default": "./src/remote-setup/index.ts"
    }
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@thyrox/app-host": "workspace:*",
    "@thyrox/command-runtime": "workspace:*",
    "@thyrox/config": "workspace:*",
    "@thyrox/local-observability": "workspace:*",
    "@thyrox/provider": "workspace:*",
    "@thyrox/shell": "workspace:*",
    "@thyrox/storage": "workspace:*",
    "axios": "^1.20.0",
    "zod": "^4.3.6"
  }
}
