#!/usr/bin/env bash
# THYROX — commit-msg. Mide el ancho de línea en COLUMNAS de terminal.
#
# Por qué existe, y por qué el proveedor lo estrena
# ------------------------------------------------
# `commit-conventions.md` fija el cuerpo a 72 desde la ÉPICA 4 y declara que
# el hook «NO valida el body». Medido al escribir esto: los cinco consumidores
# llevan un `commit-msg` cada uno —cinco copias con cinco md5 distintos— y los
# cinco validan sólo el asunto con `${#SUBJECT}`. El cuerpo no lo medía nadie
# en ninguno de los seis repos, así que se comprobaba a mano con `awk`, y el
# `awk` de esta máquina es mawk: cuenta octetos, no columnas.
#
# THYROX no tenía hook de `commit-msg`, así que aquí no hay conducta previa
# que romper — por eso el mecanismo se estrena en el proveedor y su extensión
# a los cinco consumidores queda registrada como sucesor, no forzada en el
# mismo pase.
#
# AVISA, NO BLOQUEA — directiva del ejecutor: «no seas tan rígido con los
# commits, hay implementaciones más importantes». Medido antes de decidirlo:
# de los 50 commits recientes de este repo, 20 serían rechazados, y son prosa
# real de 73 a 76 columnas, no falsos positivos. Bloquear por eso pelearía en
# cada commit por una propiedad cosmética, y un gate que se pelea se aprende a
# saltar con `--no-verify` — que es como una regla se vuelve ruido.
#
# El valor está en el MECANISMO, no en el bloqueo: `src/verify/commit_message.py`
# es invocable a mano antes de escribir el mensaje, y ahí sí decide. Mismo
# precedente que `coherence-audit-gate.md`: surfacing automático, exit 0.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$HERE")"
GATE="$ROOT/src/verify/commit_message.py"

# Rehusar en vez de omitir: un `exit 0` con el gate inalcanzable no distingue
# «el mensaje cabe» de «no pude medirlo», y el llamador lee ese 0 como permiso.
if [[ ! -f "$GATE" ]]; then
    echo "commit-msg REHUSADO — no se encontro $GATE" >&2
    echo "  No se emite veredicto: un 0 aqui seria un verde falso." >&2
    exit 2
fi
if ! command -v python3 >/dev/null 2>&1; then
    echo "commit-msg REHUSADO — falta python3, el gate no se pudo correr." >&2
    exit 2
fi

python3 "$GATE" "$1" || true   # avisa; el veredicto no detiene el commit

# Segundo eje: la cita durable RESUELVE, no sólo tiene la FORMA
# -------------------------------------------------------------
# `src/hooks/detect_ephemeral_citation.py` (septimo detector de PreToolUse) ya
# mide que un `board #N` venga acompanado de un `TASK-<CAPA>-NNNN`. Mide la
# FORMA. No puede medir el REFERENTE: un PreToolUse es puro por construccion
# —no abre el store— y bajo este harness ni siquiera dispara (H-DOCS-1010).
#
# Medir la forma y concluir sobre el referente es el sub-patron C de
# `metrica-decide-la-conclusion.md`, y ya costo un commit publicado: `4acece94`
# cita `TASK-THYROX-0445`, que tiene forma durable impecable y no nombra a
# nadie —es el ordinal del board relleno a cuatro digitos—. La cita real era
# `TASK-THYROX-0095`. Medido: 13 de 114 citas del historial, todas esa forma.
#
# AVISA, NO BLOQUEA, con su graduacion DECLARADA: hay deuda heredada en la
# historia publicada, que no se enmienda, asi que bloquear hoy peleria por algo
# que el commit de hoy no causo. La CIFRA no se transcribe aqui —es propiedad de
# un artefacto vivo y caduca sin que nadie toque este archivo, que es lo que
# `calibration-verified-numbers.md` prohibe—: la publica el comando.
#
#     PYTHONPATH=src python3 src/verify/citation_resolution.py --history 50
#
# Medido al cablearlo (2026-09-17T20:04:33): 8 sin resolver de 35 citas
# distintas. Eso es evidencia fechada de un episodio, no el estado de manana.
# GRADUACION: cuando ese comando sostenga 0 sin resolver, el `|| true` se retira
# y el `case` de abajo deja de tratar el 1 como aviso.
#
# La REFUSAL no se traga: exit 2 es «no pude medir», que no es lo mismo que
# «medi y hay deuda» (exit 1). Tragarse el 2 daria un verde que el llamador lee
# como permiso — el mismo defecto que el guard del gate de arriba evita.
GATE_CITA="$ROOT/src/verify/citation_resolution.py"
if [[ ! -f "$GATE_CITA" ]]; then
    echo "commit-msg REHUSADO — no se encontro $GATE_CITA" >&2
    echo "  No se emite veredicto: un 0 aqui seria un verde falso." >&2
    exit 2
fi
PYTHONPATH="$ROOT/src" python3 "$GATE_CITA" "$1"
case $? in
    0|1) : ;;   # 0 = todas resuelven · 1 = deuda heredada, avisa y no detiene
    *)   echo "commit-msg REHUSADO — el gate de cita no pudo medir." >&2
         exit 2 ;;
esac
exit 0
