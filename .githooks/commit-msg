#!/usr/bin/env bash
# THYROX — commit-msg. Mide el ancho de línea en COLUMNAS de terminal.
#
# Por qué existe, y por qué el proveedor lo estrena
# ------------------------------------------------
# `commit-conventions.md` fija el cuerpo a 72 desde la ÉPICA 4 y declara que
# el hook «NO valida el body». Medido al escribir esto: los cinco consumidores
# llevan un `commit-msg` cada uno —cinco copias con cinco md5 distintos— y los
# cinco validan sólo el asunto con `${#SUBJECT}`. El cuerpo no lo medía nadie
# en ninguno de los seis repos, así que se comprobaba a mano con `awk`, y el
# `awk` de esta máquina es mawk: cuenta octetos, no columnas.
#
# THYROX no tenía hook de `commit-msg`, así que aquí no hay conducta previa
# que romper — por eso el mecanismo se estrena en el proveedor y su extensión
# a los cinco consumidores queda registrada como sucesor, no forzada en el
# mismo pase.
#
# AVISA, NO BLOQUEA — directiva del ejecutor: «no seas tan rígido con los
# commits, hay implementaciones más importantes». Medido antes de decidirlo:
# de los 50 commits recientes de este repo, 20 serían rechazados, y son prosa
# real de 73 a 76 columnas, no falsos positivos. Bloquear por eso pelearía en
# cada commit por una propiedad cosmética, y un gate que se pelea se aprende a
# saltar con `--no-verify` — que es como una regla se vuelve ruido.
#
# El valor está en el MECANISMO, no en el bloqueo: `src/verify/commit_message.py`
# es invocable a mano antes de escribir el mensaje, y ahí sí decide. Mismo
# precedente que `coherence-audit-gate.md`: surfacing automático, exit 0.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$HERE")"
GATE="$ROOT/src/verify/commit_message.py"

# Rehusar en vez de omitir: un `exit 0` con el gate inalcanzable no distingue
# «el mensaje cabe» de «no pude medirlo», y el llamador lee ese 0 como permiso.
if [[ ! -f "$GATE" ]]; then
    echo "commit-msg REHUSADO — no se encontro $GATE" >&2
    echo "  No se emite veredicto: un 0 aqui seria un verde falso." >&2
    exit 2
fi
if ! command -v python3 >/dev/null 2>&1; then
    echo "commit-msg REHUSADO — falta python3, el gate no se pudo correr." >&2
    exit 2
fi

python3 "$GATE" "$1" || true   # avisa; el veredicto no detiene el commit
exit 0
