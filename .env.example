# THYROX — el contrato de las dos entradas (DEC-04)
#
# Toda ruta que sea el HOGAR de algo se pasa por una constante con DOS entradas,
# ambas de entorno: el VALOR, y la RUTA al archivo que lo declara. Este archivo
# es esa segunda entrada — el que `THYROX_ENV_FILE` nombra, o el que el ascenso
# encuentra si nadie lo nombra.
#
# Se copia a `.env` y se rellena.
#
# SUPERADO 2026-09-10 por directiva del ejecutor. Este párrafo decía: *«`.env`
# NO se versiona, y eso es la DEC-04 aplicada a sí misma: su valor es del
# CONSUMIDOR, no del proveedor. Commitear `THYROX_ROOT=/home/user/thyrox` sería
# thyrox decidiendo dónde clona cada usuario — el mismo `/home/user` cableado
# que el mecanismo existe para retirar.»* Se conserva porque el razonamiento
# sigue siendo cierto y el costo hay que poder leerlo, no porque siga rigiendo.
#
# Lo que cambia: `.env` sale del `.gitignore` y se versiona. La razón que lo
# gobierna es que su contenido es EVIDENCIA — las seis claves son rutas del
# árbol de esta sesión, no credenciales (medido: 0 secretos en 8 líneas) — y un
# contrato cuyo valor vigente nadie puede leer es la mitad de un mecanismo.
#
# El costo, declarado y no oculto: un clon en otra ruta hereda
# `THYROX_ROOT=/home/user/thyrox`, que ahí no existe, y la precedencia lo
# resuelve DE VUELTA hacia el consumidor — el proceso gana sobre este archivo, y
# `bash src/session/write-env.sh --force` lo reescribe con el árbol real. Sin
# eso, el valor heredado apunta a un directorio ausente en vez de caer al
# ascenso, que es peor que no declarar nada: falla apuntando, no falla callando.
#
# El escritor lo genera derivando cada valor del árbol real:
#
#     bash src/session/write-env.sh
#
# Precedencia de cada clave, siempre la misma: el proceso primero (quien exporta
# una variable para UNA invocación está corrigiendo a propósito lo que el
# archivo dice para todas), después este archivo, y sólo entonces el ascenso.

# --- Las dos entradas del núcleo ------------------------------------------
# La raíz de thyrox. La deriva `paths/reach.py::thyrox_root()`.
THYROX_ROOT=

# El árbol que contiene los clones hermanos (thyrox y los cinco kaupamex-*).
# Sustituye al `/home/user` que nueve guiones codificaban a mano.
THYROX_REACH_ROOT=

# --- El consumidor --------------------------------------------------------
# La raíz del clon que consume thyrox en esta sesión. Vacío = se deriva del cwd.
THYROX_CONSUMER=

# El hogar del banco de evidencia. Hay DOS grafías, y la de arriba manda:
#
#   THYROX_WORKBENCH_<CLONE>   por repositorio — API, DOCS, DB, SERVER, UI
#   THYROX_WORKBENCH_DIR      global, para una invocación de un solo árbol
#
# La familia por clon existe porque **un proceso resuelve varios árboles**, y
# una variable global no puede decir dos verdades a la vez. Medido: con
# `THYROX_EVIDENCE_DIR=eventos` exportada, api componía `scripts/eventos` —una
# ruta que no existe en ningún repositorio— mezclando el segmento de un árbol
# con el de otro; y `THYROX_ENV_FILE` apuntando a un archivo único daba a docs
# el hogar de api. Los dos pasaban sin error.
#
# Los dos hogares vivos, y su forma de declararlos en el `.env` de cada clon:
#
#   THYROX_WORKBENCH_API=/home/user/kaupamex-api/scripts/workbench
#   THYROX_WORKBENCH_DOCS=/home/user/kaupamex-docs/.claude/eventos
#
# `api` no se llama `eventos` por una razón medida: en ese árbol «evento» ya
# nombra otras dos cosas —los 31 del cliente y los `tengu_*` de telemetría— y
# tres directorios encarnan la colisión. Ver `api: scripts/workbench/README.md`.
#
# Sin declarar, un CONSUMIDOR no se rehúsa: cae a
# `<consumidor>/<estado>/<evidencia>`. El PROVEEDOR sí — su `.claude/` no lo
# distingue de un consumidor, así que el ascenso no puede decidir y
# `workbench_dir()` lanza `ConsumerUnknownError` en vez de componer un hogar
# dentro de thyrox que `declarations.py` no lista. Por eso el proveedor declara
# el suyo, y lo emite `src/session/write-env.sh` para que un regenerado no lo
# borre en silencio:
#
#   THYROX_WORKBENCH_DIR=/home/user/thyrox/.claude/workbench
#
# El valor es SIEMPRE una ruta absoluta. Un segmento relativo se ancla contra
# la raíz que resuelva quien lea, y ésa es la vía por la que L-028 midió once
# bancos perdidos.
#
# `python3 src/paths/declarations.py` dice por clon qué está declarado y qué
# resuelve THYROX por ti.
THYROX_WORKBENCH_DIR=

# El segmento de estado dentro del clon, y el de evidencia dentro de él. Ambos
# caen a un default y NO rehúsan, a diferencia de THYROX_WORKBENCH_DIR: un
# nombre de segmento no decide dónde aterrizan las piezas, un hogar de banco sí.
# Quien quiera `workbench` en vez de `eventos` lo declara aquí — voltear el
# default dejaría de excluir 241 entradas en kaupamex-docs y 29 en kaupamex-api
# (medido al portar; ver H-DOCS-1138 y la tarea #220).
THYROX_STATE_DIR=
THYROX_EVIDENCE_DIR=

# El store de tareas y agentes. Declararlo aqui es el caso del CONSUMIDOR: su
# store vive en el clon que despacha, y esta constante lo fija.
#
# Vacio NO es un rehuse: el store pasa a ser de thyrox
# (`<THYROX_ROOT>/agent-results/agent_store.sqlite3`), y su directorio se crea
# bajo demanda, idempotente. Lo prohibido no era tener default — era DERIVARLO
# por aritmetica de `__file__`: `parents[N]` describe el arbol donde el guion
# vivia, no donde corre, no crea nada, y falla EN SILENCIO (el llamador lee «la
# ruta no existe» como «no hay datos»). Aqui la raiz sale de la cadena
# declarada. Ver `src/paths/reach.py::agent_store_path`.
THYROX_AGENT_STORE=

# --- Localizadores: sólo se tocan si el árbol cambia de forma --------------
# El marcador por el que el ascenso reconoce la raíz de thyrox.
THYROX_LOCATOR=src/paths/reach.py

# La mitad shell del localizador, que los guiones cargan con `source`.
THYROX_LIB_REACH=src/lib/reach.sh

# La biblioteca de la cadena de herramientas, que el preflight carga con
# `source`. Sin ella no hay nada que interrogar, y
# `src/verify/check-toolchain-ready.sh` rehusa con exit 2 en vez de publicar
# un cero: un verde ahi no distinguiria «la cadena esta sana» de «no la pude
# medir».
THYROX_LIB_TOOLCHAIN=src/lib/toolchain.sh

# --- El árbol: raíz por clon y tramo extensible ---------------------------
# Una raíz declarada POR CLON, que gana sobre el ascenso y sobre
# THYROX_REACH_ROOT. La grafía la compone `reach.py::env_names(repo)`: el
# nombre del clon en mayúsculas con `-` a `_`. Se declara sólo el clon que
# viva fuera del árbol común — no hace falta declararlos los seis.
#
#   THYROX_REACH_API=      THYROX_REACH_DB=     THYROX_REACH_DOCS=
#   THYROX_REACH_SERVER=   THYROX_REACH_UI=     THYROX_REACH_THYROX=

# Raíces ADICIONALES a las de los clones, separadas por `:` como `PATH` —
# la convención que un consumidor de shell espera.
THYROX_EXTRA_REACH_ROOTS=

# El roster de clones, declarado. Estaba codificado como los cinco nombres de
# un producto concreto, y eso ataba el mecanismo a ese producto: el roster de
# un multi-repo es dato del consumidor, no conocimiento del proveedor. El
# ORDEN es parte del contrato — lo declarado conserva el que se escribió, lo
# derivado va ordenado, para que un artefacto que itere no produzca diffs por
# reordenamiento. Lo lee `reach.py::REACH_ROOTS_VAR`.
THYROX_REACH_ROOTS=

# El prefijo común de los clones hermanos (`kaupamex-`). Se DERIVA de los
# hermanos del proveedor cuando no se declara; la clave existe para el árbol
# cuyo prefijo la derivación no acierta. Lo lee `reach.py::derive_clone_prefix`.
THYROX_CLONE_PREFIX=

# --- Hogares que el consumidor declara y thyrox NO inventa ----------------
# El directorio de definiciones de agente. Antes se componía como
# `.claude/agents` RELATIVO, así que su `glob` dependía del cwd y devolvía
# cero sin error — un silencio que se lee como «no hay agentes».
THYROX_AGENTS_DIR=

# El hogar de los logs del trabajo en segundo plano. Hay DOS grafías, y la de
# arriba manda — la misma familia que `THYROX_WORKBENCH_<CLONE>` y
# `THYROX_JOBS_<CLONE>`, y por la misma razón: **un solo proceso resuelve varios
# árboles**, y una variable global no puede decir dos verdades a la vez.
#
#   THYROX_BACKGROUND_LOG_<CLONE>   por repositorio — API, DOCS, DB, SERVER, UI
#   THYROX_BACKGROUND_LOG_DIR      global, para una invocación de un solo árbol
#
# NINGUNA cae a un default: inventar un hogar de logs esparce evidencia donde
# nadie la pidió, y —a diferencia de un error— no se nota hasta que alguien la
# busca. `background.log_dir` rehúsa, y sus dos consumidores de shell heredan
# ese rehúse: `run-task-pool.sh` sale 4 en vez de componer
# `${TMPDIR:-/tmp}/kaupamex-pool`, que era su default y perdía los logs de una
# tanda con el contenedor.
#
# Un valor RELATIVO se compone bajo la raíz del clon (`resolve_home`); uno
# absoluto nombra un sitio concreto. Así `bg.sh start <n> --dir <slug>` aterriza
# en `<hogar>/<slug>/<n>.log`, que es la forma que `build-logs.md` exige.
#
#   THYROX_BACKGROUND_LOG_DOCS=build-logs
#
# `BG_DIR` es la grafía HEREDADA del argumento por invocación. No lleva el
# prefijo `THYROX_`, así que `verify/check_env_contract_keys.py` —que declara
# `PREFIX = "THYROX_"`— no la ve: era la única ruta de hogar del árbol invisible
# a su propio gate de contrato. Se conserva porque `bg.sh log`/`status` no
# tienen bandera, y pasa por la MISMA resolución que `--dir`.
THYROX_BACKGROUND_LOG_DIR=

# La adopción de una flota de segundo plano ajena — el `adoptShellOutputRoot`
# de la referencia (2.1.266). Las tres son del CONSUMIDOR y ninguna cae a un
# default: se declaran cuando esta sesión toma la salida de otra.
#
#   MARKER      el marcador terminal que el corredor anfitrión escribe, si no
#               es el nuestro (`EXIT=`)
#   OUTPUT_ROOT la raíz de salida que se adopta; de ella se DERIVA la ruta de
#               cada tarea, en vez de leerla de ningún texto
#   SESSION     el identificador de la sesión cuyo subdirectorio se adopta
THYROX_BACKGROUND_MARKER=
THYROX_BACKGROUND_OUTPUT_ROOT=
THYROX_BACKGROUND_SESSION=

# El directorio contra el que el cliente resuelve un objetivo RELATIVO de hook.
# Sin declarar se usa el cwd del proceso, que es lo más cercano al `launchDir`
# de la referencia disponible aquí. Lo lee `session/user_wiring.py`.
THYROX_HOOK_CWD=

# El clon que se está configurando — el CONSUMIDOR de `verify/install-hooks.sh`.
# Sin declarar sale de `git rev-parse --show-toplevel`; el guion REHÚSA si no
# hay repositorio git en el cwd, en vez de configurar un árbol que nadie eligió.
THYROX_TARGET_REPO=

# La ruta del intérprete DENTRO de la raíz del proveedor, relativa a ella. Se
# declara una vez en `lib/toolchain.sh`; escribirla en cada función sería la
# segunda fuente de verdad que `calibration-verified-numbers.md` prohíbe para
# una cifra y vale igual para una ruta. Default: `.venv/bin/python`.
THYROX_TOOLCHAIN_INTERPRETER_PATH=

# El interprete de REPUESTO que un envoltorio de `bin/` usa cuando falta
# `.venv`. Sin el, un envoltorio sin entorno rehusa con exit 2 y bloquea la
# sesion; con el, corre con este interprete si cumple el piso de
# `requires-python` del `pyproject.toml`, y avisa por stderr. Declarado para
# que un control apunte a un interprete ausente —o bajo el piso— sin tocar el
# PATH de la maquina. Lo lee `src/session/generate_bin.py` al emitir cada
# envoltorio. Default: `python3`.
THYROX_PYTHON_FALLBACK=

# GNU parallel es opt-in, nunca automático: instalar un paquete del sistema
# sin que nadie lo pida es una mutación que esta clave hace explícita. En 0/1
# (default 0) — `thyrox_toolchain_require_parallel` la lee para decidir si
# intenta instalar cuando el binario no está.
THYROX_INSTALL_PARALLEL=

# El nombre del binario que se busca en el PATH. Declarado en vez de fijo
# porque un control necesita poder apuntar la búsqueda a un nombre ausente
# sin vaciar el PATH entero. Default: `parallel`.
THYROX_TOOLCHAIN_PARALLEL_BIN=

# El comando que lo instala si `THYROX_INSTALL_PARALLEL=1` y no está. El
# éxito NO se lee de su código de salida — puede instalar en otro intérprete,
# o el proxy puede devolver algo que no es el paquete — se re-comprueba el
# binario después. Default: `sudo apt-get install -y parallel`.
THYROX_TOOLCHAIN_PARALLEL_INSTALL_CMD=

# GNU Time, opt-in con `THYROX_INSTALL_GNU_TIME=1`: la memoria pico de cada
# ítem del pool (`headless-pool` escribe `<n>.time`). El binario se verifica
# por su identidad («GNU Time»), no por el código de salida del instalador.
# Defaults: `/usr/bin/time` y `sudo apt-get install -y time`.
THYROX_TOOLCHAIN_TIME_BIN=
THYROX_TOOLCHAIN_TIME_INSTALL_CMD=

# `bin/headless-pool`: un doble del ejecutor de cada ítem, que habla el
# contrato de `thyrox -p` (pruebas, arnés de GPU). Vacía = `bin/cli`, el
# `thyrox -p` propio, que es el único ejecutor. `HEADLESS_POOL_CLAUDE`, que
# permitía correr `claude -p`, se retiró y rehúsa con exit 2.
HEADLESS_POOL_RUNNER=

# Dónde guarda el pool su historial por plantilla (`pool_history.py`): una
# fila por ejecución medida, de la que la siguiente deriva TTL y `--memfree`.
# Default: `<caché del repo>/headless-pool`.
HEADLESS_POOL_HISTORY_DIR=

# La memoria de un vecino que corre junto al pool (p. ej. el `tsc` completo
# del pipeline, 2.0 GB medidos): se SUMA a la memoria pico medida del ítem al
# derivar `--memfree`. Formato de `lib/memory.sh` (2G, 512M). Default: vacía.
HEADLESS_POOL_MEMFREE_RESERVE=

# La VRAM de cada ítem (`gpu_monitor.py`), que GNU Time no ve. El binario de
# nvidia-smi; sin él el pool lo declara y no mide la VRAM. Default: `nvidia-smi`.
HEADLESS_POOL_NVIDIA_SMI=

# Cada cuántos segundos se muestrea la VRAM de un ítem. Un pico más corto que
# el intervalo no se ve. Default: 0.5.
HEADLESS_POOL_GPU_INTERVAL=

# VRAM (MiB enteros) que se RESTA de la libre antes de calcular cuántos ítems
# caben a la vez: lo que queda para el resto de lo que usa la GPU. Default: 0.
HEADLESS_POOL_VRAM_RESERVE_MIB=

# El registro de VRAM comprometida (`gpu_monitor admit/release`): cada ítem
# reserva su pico bajo lock antes de arrancar y lo suelta al terminar, así dos
# ítems —del mismo pool o de dos pools— no toman la misma VRAM libre. La
# reserva de un dueño muerto deja de contar. Default:
# `<base del historial>/vram-reservations.json`.
HEADLESS_POOL_VRAM_LEDGER=

# El piso de VRAM (MiB enteros) que pide cada ítem aunque el historial diga
# menos, y lo que pide mientras el historial no esté calibrado (la última
# ejecución no midió la VRAM de todos sus ítems, o alguno duró menos de dos
# muestras). Sin piso, un historial sin calibrar pide la GPU entera —de a uno,
# también entre pools— hasta que una ejecución lo calibre (H-THYROX-192).
# Default: 0.
HEADLESS_POOL_VRAM_MIN_MIB=

# El TTL de la caché de prompt, en el orden de `QCt` del ejecutable 2.1.282
# (`src/packages/agent/promptCacheTtl.ts`): forzar 5m gana a todo; luego la
# variable del origen —la conversación principal y los `-p` leen la primera,
# subagentes y demás la segunda—; luego lo declarado; luego activar 1h (o en
# Bedrock, su variable). Un valor que no es "5m" ni "1h" rehúsa: no cae en
# silencio al default. `headless-pool` las aplica sobre `--cache-ttl` y pasa
# el TTL al ítem como THYROX_CODE_PROMPT_CACHE_TTL.
THYROX_FORCE_PROMPT_CACHING_5M=
THYROX_CODE_PROMPT_CACHE_TTL=
THYROX_CODE_SUBAGENT_PROMPT_CACHE_TTL=
THYROX_ENABLE_PROMPT_CACHING_1H=
THYROX_ENABLE_PROMPT_CACHING_1H_BEDROCK=

# gawk es opt-in por la misma razon que parallel: instalar un paquete del
# sistema sin que nadie lo pida es una mutacion. En 0/1 (default 0) — el eje
# de PRESENCIA de `thyrox_toolchain_require_gawk` la lee.
THYROX_INSTALL_GAWK=

# El binario de awk que los guiones invocan. El eje NO es si gawk esta
# instalado: es CUAL awk responde. En Debian `awk` resuelve por
# /etc/alternatives/awk, asi que gawk puede estar presente y el nombre seguir
# apuntando a mawk — que revienta ante un cuantificador de intervalo seguido
# de grupo (exit 100, `REcompile() - panic`; h-docs-1068). Default: `awk`,
# porque lo que hay que proteger es el nombre que los guiones ESCRIBEN.
THYROX_TOOLCHAIN_AWK_BIN=

# El comando que instala gawk si THYROX_INSTALL_GAWK=1 y el nombre no
# resuelve. El exito NO se lee de su codigo de salida: se re-comprueba el
# binario. Y NO arregla el eje de conducta — instalar el paquete no cambia a
# donde apunta la alternativa. Default: `sudo apt-get install -y gawk`.
THYROX_TOOLCHAIN_GAWK_INSTALL_CMD=

# El interprete al que se le pregunta por el modulo `sqlite3`. Declarado para
# que un control pueda apuntar la sonda a un interprete ausente sin romper el
# resto. Sin valor, se deriva del entorno del proveedor.
THYROX_TOOLCHAIN_PYTHON_BIN=

# El binario de bun, por la misma razon: un control necesita apuntar a un
# nombre que no resuelve. Default: `bun`.
THYROX_TOOLCHAIN_BUN_BIN=

# El binario de `pdftotext` (poppler) con que la extraccion documental saca el
# texto de un PDF. Declarado, igual que los otros binarios de esta seccion,
# para que un control apunte a un nombre que no resuelve y mida el rechazo.
# Lo lee `src/corpus/pdf_to_text.py`. Default: `pdftotext`.
THYROX_TOOLCHAIN_PDFTOTEXT_BIN=

# El comando que instala poppler-utils si THYROX_INSTALL_PDF_TEXT=1 y
# `pdftotext` no resuelve. El exito NO se lee de su codigo de salida: se
# re-comprueba el binario. Lo lee `src/lib/toolchain.sh`.
# Default: `sudo apt-get install -y poppler-utils`.
THYROX_TOOLCHAIN_PDF_TEXT_INSTALL_CMD=

# poppler completo: `pdftotext` (arriba) y `pdftoppm`, sondeados por CONDUCTA
# sobre un PDF de una pagina que el propio `src/lib/toolchain.sh` embebe. La
# instalacion es opt-in (THYROX_INSTALL_POPPLER=1) y su exito se re-comprueba,
# no se lee del codigo de salida del instalador. Defaults: `pdftoppm` y
# `sudo apt-get install -y poppler-utils`.
THYROX_INSTALL_POPPLER=
THYROX_TOOLCHAIN_PDFTOPPM_BIN=
THYROX_TOOLCHAIN_POPPLER_INSTALL_CMD=
# La sonda de poppler, en PAR: un PDF en base64 y el texto que ese PDF
# contiene. Sin valor, el PDF de una pagina con THYROX-PDF-PROBE que trae
# `src/lib/toolchain.sh`. Un par que no coincida hace fallar la sonda.
THYROX_TOOLCHAIN_POPPLER_PROBE_PDF_B64=
THYROX_TOOLCHAIN_POPPLER_PROBE_TEXT=

# TeX Live: un `xelatex` que COMPILE el documento del consumidor. thyrox no
# compila documentos, asi que los paquetes y el documento de sonda son del
# CONSUMIDOR; sin ninguno de los dos declarado, la sonda del preflight se
# omite en vez de medir un documento que nadie pidio. Opt-in con
# THYROX_INSTALL_TEXLIVE=1. Defaults: `xelatex`, el paquete `texlive-xetex`
# y `sudo apt-get install -y --no-install-recommends <paquetes>`.
THYROX_INSTALL_TEXLIVE=
THYROX_TOOLCHAIN_XELATEX_BIN=
THYROX_TOOLCHAIN_TEXLIVE_PACKAGES=
THYROX_TOOLCHAIN_TEXLIVE_PROBE_FILE=
# El documento TeX de respaldo que se compila si no se declara un archivo.
# Sin valor, un `article` minimo con el texto THYROX.
THYROX_TOOLCHAIN_TEXLIVE_PROBE_DOC=
THYROX_TOOLCHAIN_TEXLIVE_INSTALL_CMD=

# hunspell: revision ortografica contra el diccionario que el CONSUMIDOR
# declara (ruta sin extension o nombre instalado); el proveedor no supone un
# idioma. La sonda exige un par: una palabra que el diccionario tiene que
# ACEPTAR y otra que tiene que RECHAZAR — un diccionario que acepta todo, o
# que rechaza todo, resuelve como binario y no mide nada. Opt-in con
# THYROX_INSTALL_HUNSPELL=1. Defaults: `hunspell` y
# `sudo apt-get install -y hunspell`.
THYROX_INSTALL_HUNSPELL=
THYROX_TOOLCHAIN_HUNSPELL_BIN=
THYROX_TOOLCHAIN_HUNSPELL_INSTALL_CMD=
THYROX_TOOLCHAIN_HUNSPELL_DICTIONARY=
THYROX_TOOLCHAIN_HUNSPELL_PROBE_ACCEPT=
THYROX_TOOLCHAIN_HUNSPELL_PROBE_REJECT=

# El hogar de dependencias de la mitad TypeScript. Es el EJE 2 de la sonda de
# bun y no se deduce del eje 1: bun puede estar y `bun install` no haberse
# corrido, con los entrypoints .ts igual de muertos. Sin valor, se compone
# como `<raiz>/node_modules`.
THYROX_TOOLCHAIN_NODE_MODULES_HOME=

# Los manifiestos cuya AUSENCIA rehusa: son DECLARACIONES, y sin ellas no hay
# que instalar ni con que compilar. Default:
# `pyproject.toml package.json tsconfig.json`.
THYROX_TOOLCHAIN_MANIFESTS_REQUIRED=

# Los manifiestos cuya ausencia solo AVISA: son RESOLUCIONES y se regeneran
# desde las declaraciones. Un clon sin `bun.lock` es perfectamente instalable.
# Default: `uv.lock bun.lock bunfig.toml`.
THYROX_TOOLCHAIN_MANIFESTS_OPTIONAL=

# El hogar del tablero de tareas. Es parámetro del consumidor: sin esta clave,
# un clon que corra el cliente con otro `HOME` tenía que editar el código.
THYROX_BOARD_ROOT=

# El `~/.claude` que gobierna — el hogar de los archivos sueltos que
# `reconcile_user_hooks` concilia.
THYROX_USER_CLAUDE_DIR=

# El hogar de los resultados que el hook de error persiste. Grafía heredada
# admitida: `KAUPAMEX_RESULTS_DIR`.
THYROX_RESULTS_DIR=

# El hogar de los buzones entre pares (`peer_mailbox`). Sin declarar, rehúsa.
THYROX_MAILBOX_DIR=

# El directorio de skills que thyrox aloja para sus consumidores.
THYROX_SKILLS_DIR=

# El hogar de las reglas EMITIDAS. Hay dos grafías, y la de arriba manda:
#
#   THYROX_RULES_<CLONE>   por repositorio — API, DB, DOCS, SERVER, UI
#   THYROX_RULES_DIR      familia, para los cinco a la vez
#
# La familia por clon existe por lo mismo que la de workbench: un proceso
# resuelve varios árboles y una variable global no puede decir dos verdades a
# la vez. Medido antes de introducirla: con sólo `THYROX_RULES_DIR`, declarar
# el hogar de `db` le daba a los otros cuatro clones **el hogar de db**, y
# ninguna fila del registro avisaba.
#
# Aquí el valor SÍ puede ser un segmento relativo, al revés que
# THYROX_WORKBENCH_DIR: `consumerRulesDir` lo compone sobre la raíz del clon
# que se le pasa (`resolveHome`), así que un `.claude/rules` relativo dice lo
# correcto para los cinco. Una absoluta sigue nombrando un sitio concreto.
#
# Sin declarar: `<raíz>/<estado>/rules`, con el segmento de estado que
# THYROX_STATE_DIR fija. Lo consume `src/rules/paths.ts`, que separa
# `rulesDir()` —el hogar del PROVEEDOR— de `consumerRulesDir(root)`: un
# resolutor que cae al hogar del proveedor cuando se le pasa la raíz de un
# consumidor compone una ruta dentro de thyrox y la publica como si fuera del
# clon (#286, medido con `--consumer /home/user/kaupamex-api`).
THYROX_RULES_DIR=

# El archivo del store de observabilidad — la ruta, no el directorio.
THYROX_STORE=

# El catálogo de modelos, extraído del ejecutable. Vive en el corpus
# versionado; se declara aquí quien lo tenga en otro sitio.
THYROX_MODEL_CATALOG=

# El ledger de trabajos en segundo plano, y su archivo. El ledger es POR
# SESIÓN —`.claude/jobs-ledger/<sesión>`— porque dos sesiones que compartan
# uno se roban los marcadores entre sí; el archivo es común, porque un
# trabajo terminado ya no pertenece a nadie. Grafías heredadas admitidas:
# `KX_TRABAJOS_DIR` y `KX_TRABAJOS_ARCHIVO_DIR`, que el shell aún acepta.
#
#   THYROX_JOBS_LEDGER_DIR     la RAÍZ: cada sesión cuelga su subdirectorio
#   THYROX_SESSION_LEDGER_DIR  el ledger de esta sesión, tal cual (suites,
#                              el respaldo de `user_wiring`)
#
# NO es `THYROX_JOBS_DIR`: ése es el hogar de las CORRIDAS (abajo). Hasta el
# 2026-09-26 las dos cosas compartían variable, y exportar el valor de las
# corridas metía los `.job` del ledger entre ellas.
THYROX_JOBS_LEDGER_DIR=
THYROX_SESSION_LEDGER_DIR=
THYROX_JOBS_ARCHIVE_DIR=

# El hogar de los RUNS de trabajo, por repositorio. Misma familia que
# `THYROX_WORKBENCH_<CLONE>` y por la misma razón: un solo proceso resuelve
# varios árboles, y una variable global no puede decir dos verdades a la vez.
#
#   THYROX_JOBS_<CLONE>   por repositorio — API, DOCS, DB, SERVER, UI
#   THYROX_JOBS_DIR      global, para una invocación de un solo árbol
#
# La clave por clon GANA sobre la global, y su valor pasa por `resolve_home`:
# como SEGMENTO relativo dice «en cada clon, este subdirectorio»; como absoluta,
# nombra un hogar concreto. Se declara en el `.env` DEL CONSUMIDOR, nunca en el
# del proveedor — ahí sería el hogar de otro árbol, que es el defecto que la
# familia existe para evitar. Sin ella, un run de `api` nacía en
# `thyrox/.claude/jobs/`: L-028 con los trabajos como sujeto.
#
#   THYROX_JOBS_API=/home/user/kaupamex-api/scripts/evidence
#   THYROX_JOBS_DOCS=/home/user/kaupamex-docs/.claude/jobs
#
# La grafía es `THYROX_<FAMILY>_<CLONE>` y no `<CLONE>_<FAMILY>_DIR`, medido: el
# árbol ya tiene tres composiciones así (workbench, rules, reach); el prefijo
# `API_` está tomado en el multi-repo con otro significado (`API_URL` de la UI
# nombra el backend, no el clon); y `verify/check_env_contract_keys.py` declara
# `PREFIX = "THYROX_"`, así que una clave fuera del prefijo es invisible al
# gate — ni se cuenta ni se exige declarar aquí.
THYROX_JOBS_DIR=

# El hogar del ÍNDICE del cache de trabajo-ya-hecho. Quinta familia de la
# grafía `THYROX_<FAMILY>_<CLONE>`, y se compone igual que sus cuatro hermanas:
#
#   THYROX_CACHE_<CLONE>   por repositorio — API, DOCS, DB, SERVER, UI
#   THYROX_CACHE_DIR       global, para una invocación de un solo árbol
#
# A diferencia de THYROX_WORKBENCH_DIR, aquí SÍ hay default y NO se rehúsa: un
# índice es material reconstruible, así que un árbol sin declaración no queda
# sin mecanismo — queda con el índice bajo su zona de estado (`<estado>/cache`).
# Rehusar apagaría el ahorro por una declaración que casi ningún árbol necesita
# cambiar. La clave por clon gana sobre la global. Lo consume
# `src/cache/paths.py::cache_dir()`, que resuelve AL LLAMAR y no al importar.
#
#   THYROX_CACHE_DOCS=/home/user/kaupamex-docs/.claude/cache
#   THYROX_CACHE_API=/home/user/kaupamex-api/.claude/cache
THYROX_CACHE_DIR=

# El hogar de los TRANSCRIPTS del cliente. Sexta familia, y la única cuyo
# sujeto no es del árbol: los `.jsonl` de sesión los escribe Claude Code bajo
# el hogar del PROCESO, que no tiene por qué coincidir con el cwd de la sesión
# — medido aquí, HOME es `/root` y el cwd `/home/user`.
#
# Por eso no se deriva del árbol, como sí hace `user_wiring.live_settings`: la
# distinción es del sujeto, no del gusto. Y por eso tiene default y no rehúsa,
# como la familia `cache`: un transcript es material del cliente, y rehusar
# dejaría mudos a sus consumidores sin que ninguno gane control a cambio.
#
# Existe porque el árbol resolvía este mismo directorio de SEIS formas
# distintas, ninguna declarada, y dos de ellas —`model_catalog` y
# `session_restart`— elegían archivos DISTINTOS para la misma sesión: medido
# el 2026-09-23, uno leía 5 581 100 bytes de los 45 277 263 que la sesión
# había escrito. Lo consume `src/session/transcripts.py::transcripts_dir()`,
# que resuelve AL LLAMAR y no al importar.
#
#   THYROX_TRANSCRIPTS_DIR=/root/.claude/projects
THYROX_TRANSCRIPTS_DIR=

# Enciende las dos cláusulas ESTRICTAS de `consumer_root`. Sin ella el
# mecanismo se comporta exactamente como siempre, y ése es el punto: thyrox es
# un PROVEEDOR, y endurecer una resolución sin preguntar rompe a quien la
# usaba de otro modo — en silencio, porque su árbol no declaraba nada que
# revisar. La declaración manda; quien no declara se queda con lo que tenía.
#
# Con ella, dos cláusulas:
#
#   1. `consumer_root` REHÚSA cuando el punto de partida es el proveedor.
#      Declarar cuál es el consumidor no convierte al proveedor en uno. Medido
#      el 2026-09-23: sin esta cláusula, un gate de idioma pasó de 0 a 70
#      nombres al declararse THYROX_CONSUMER. Ninguno era nuevo — dejó de leer
#      el baseline del PROVEEDOR y lo buscó en el consumidor, donde no está.
#   2. Una declaración RELATIVA de THYROX_CONSUMER se resuelve contra la raíz
#      del contenedor, no contra el directorio actual. Una ruta relativa
#      resuelta por cwd da una respuesta distinta desde cada directorio.
#
# Apagada con «», «0», «false», «no» u «off»; encendida con cualquier otro
# valor. Lo consume `src/paths/reach.py::strict_consumer()`.
#
#   THYROX_CONSUMER_STRICT=1
THYROX_CONSUMER_STRICT=

# El destino de los comandos EMITIDOS. La fuente es `src/commands/` de este
# árbol y no se declara: es producto. Lo declarable es dónde aterrizan, que
# es asunto del consumidor. Sin declarar, `.claude/commands` bajo su raíz.
THYROX_COMMANDS_DIR=

# El `settings.local.json` del LANZADOR — el que gobierna hooks y advisor de
# la sesión, no el de ningún clon. Se DERIVA del árbol (`<padre>/.claude/`),
# nunca de `Path.home()`: HOME es `/root` mientras el cwd es `/home/user`, y
# la primera versión publicó «0 rotos sobre 0 comandos» midiendo un archivo
# que estaba a dos directorios de distancia. Lo consume `user_wiring.py`.
THYROX_LIVE_SETTINGS=

# --- El hook de tests: qué vigila y con qué corre --------------------------
# El directorio cuyos cambios disparan la suite, y el corredor que la ejecuta.
# Grafías heredadas admitidas: `KAUPAMEX_WATCHED_DIR` y `KAUPAMEX_TEST_RUNNER`.
THYROX_WATCHED_DIR=
THYROX_TEST_RUNNER=

# Guard de recursión, NO un parámetro: lo exporta el propio hook para que la
# suite que él lanza no vuelva a lanzarlo. Se declara aquí porque el censo lo
# ve como clave del contrato; un consumidor no la fija a mano.
THYROX_STOP_TESTS_RUNNING=

# Cuántos archivos de TypeScript corre a la vez `run_ts_isolated.sh`, un
# proceso de `bun test` por archivo. Default: `nproc`. Bajarlo sirve cuando
# la memoria, no la CPU, es la que se agota: cada proceso carga su grafo.
THYROX_TS_WIDTH=

# Las mitades Python y shell de `tests/run.sh`, repartidas por
# `src/verify/run_suites_isolated.sh`: cuántas suites a la vez (default
# `nproc`) y el tope en segundos de cada una (default 600). Con el tope, una
# suite colgada sale como `-- TIMEOUT <archivo>` en vez de dejar la ejecución
# esperando para siempre.
THYROX_SUITE_WIDTH=
THYROX_SUITE_TIMEOUT=

# De dónde toma `check_lint_zero.py` shellcheck, ruff y pyright. Vacío: el
# `.venv/bin` del proveedor (el grupo `lint`). Una suite lo apunta a un
# directorio falso para controlar el veredicto.
THYROX_LINT_BIN_DIR=

# Credenciales del bucle propio (`@thyrox/provider: credentials.ts`), en el
# orden de su cadena. Se dejan vacías aquí: son secretos. El token de OAuth
# puede llegar por valor, por descriptor de archivo o por archivo del host.
THYROX_CODE_OAUTH_TOKEN=
THYROX_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR=
THYROX_CODE_HOST_CREDS_FILE=

# --- Alcance de los gates y del censo -------------------------------------
# Los clones que consumen thyrox, para el gate de superficie Python.
# Declarados, nunca inventados.
THYROX_SURFACE_CONSUMERS=

# La declaración de contrapartes que consume el censo de corpus. NO cae a un
# default: qué addons hospeda un kaupamex-* y dónde guarda su declaración es
# dato del consumidor, y un default aquí decidiría por él.
#
# Se llamó `THYROX_CONTRAPARTE_DECLARATION` hasta el 2026-09-07. La grafía
# vieja NO se admite como heredada —el patrón de las `KAUPAMEX_*` existe
# porque aquéllas tienen consumidores vivos en otro repo; ésta tenía dos
# sitios de código y un fixture, todos en este árbol.
THYROX_COUNTERPART_DECLARATION=

# El censo de contrapartes: qué árbol es la REFERENCIA, cuál el censado, y
# qué bases delimitan una unidad comparable. Las tres REHÚSAN sin declarar
# —`_declared_or_refuse`— en vez de caer a un default: un censo sobre la
# raíz equivocada publica una cifra sana midiendo otro árbol, que es el
# sub-patrón A de `metrica-decide-la-conclusion.md`.
THYROX_CENSUS_REFERENCE_ROOT=
THYROX_CENSUS_ROOT=
THYROX_CENSUS_UNIT_BASES=

# El marcador por el que se reconoce una unidad comparable — el archivo cuya
# presencia dice «aquí empieza una unidad». Rehúsa igual que las tres de
# arriba, y por una razón más fuerte: es el parámetro que DISCRIMINA. Con las
# otras tres declaradas y ésta codificada, el mecanismo seguiría reconociendo
# sólo las unidades de un producto y el censo únicamente serviría para él.
THYROX_CENSUS_UNIT_MARKER=

# Los repositorios PRIVADOS donde el identificador de modelo puede citarse.
# Lista separada por comas, y deliberadamente de repositorios y no de
# organización: una organización contiene repos públicos, y ahí el modo
# encubierto sigue encendido. Vacía = ninguno, que es el default seguro.
THYROX_INTERNAL_MODEL_REPOS=

# Enciende el modo encubierto A LA FUERZA, aunque el repositorio conste
# interno. NO existe la contraria: sin declarar, el modo es AUTOMÁTICO y queda
# ENCENDIDO salvo que el remoto conste POSITIVAMENTE en la lista de arriba.
# El default seguro es encendido porque se puede empujar a un remoto público
# desde un directorio que ni siquiera es copia de trabajo de ese repositorio.
# Lo lee `tool-registry/src/undercover.ts`.
THYROX_UNDERCOVER=

# La raiz del clon cuyos gates mide el informe de migracion
# (`src/corpus/migration_report.py`). Vacia = el clon `api` del roster; si el
# roster no lo tiene, el informe REHUSA en vez de medir una ruta fantasma.
# Existe para ejercitar ese rechazo contra una raiz ausente. Se acepta tambien
# `KAUPAMEX_API_ROOT` por compatibilidad.
THYROX_MIGRATION_ROOT=

# --- Parámetros de las reglas EMITIDAS ------------------------------------
# Las dos identidades que la regla `git-author-identity` inyecta en su cuerpo.
# Son parámetro del consumidor, no del proveedor: una identidad literal en el
# productor lo ataría a un cliente. La autoría humana firma; la de servicio
# registra el commit.
THYROX_COMMIT_AUTHOR=
THYROX_COMMIT_COMMITTER=

# --- Las raíces de REFERENCIA ---------------------------------------------
# El material contra el que se construye: SÓLO LECTURA, siempre. Un `checkout`
# ahí ya es un cambio (`referencia-odoo-gobierna-las-decisiones.md`).
#
# Cada alias del catálogo (`src/reference/triple.ts`) declara su variable, y su
# grafía se DERIVA del alias en mayúsculas — `alias.toUpperCase()`. Eso es un
# contrato de derivación, no una lista: renombrar una de estas claves sin
# renombrar su alias rompe la resolución en silencio.
#
#   ODOO19C · ODOO19E · ODOO18C · ODOO18E   los cuatro árboles de Odoo
#   CCB_ROOT                                el corpus de ccb/ccnmt (dos alias, un árbol)
#   HCCW_ROOT                               los capítulos de how-claude-code-works
#   PROGRESS_ROOT                           la referencia de UI
#   CLAUDE_CODE_BIN_CORPUS                  el corpus de builds del ejecutable
#
# Sin declarar, cada una se DERIVA: lo vendorizado cuelga de `_references/` bajo
# la raíz de thyrox; lo que es un clon hermano, de `THYROX_REACH_ROOT`. Ninguna
# se escribe con `/home/user` — ese literal describe dónde clonó quien lo
# escribió, no dónde corre.

# La raíz del repositorio de referencia de Odoo. Es un hermano de los clones.
ODOO_TOOLS=

# --- Diagnóstico ----------------------------------------------------------
# Cualquier valor no vacío enciende la traza a `stderr` de los directorios de
# sistema. No es una ruta: es un interruptor.
THYROX_DEBUG=

# Overrides de banderas de funcionalidad, como un objeto JSON.
THYROX_FEATURE_FLAGS=

# --- La segunda entrada, la que este archivo ES ---------------------------
# La RUTA a este archivo. Declararla aquí dentro no sirve para encontrarlo —
# para eso se exporta en el proceso, o se deja que el ascenso lo halle. Figura
# porque es una clave del contrato y el censo la lee, y porque su ausencia de
# esta lista era justo el hueco que la DEC-04 existe para cerrar: el archivo
# que declara las rutas no declaraba la suya.
THYROX_ENV_FILE=

# THYROX_LAYER_SIGNALS — de qué archivo salen las señales de capa.
#
# Gobierna si `derive_submodule` DERIVA o si devuelve el hueco. Sin ella el
# derivador se apaga entero y toda tarea aterriza en la capa desconocida:
# medido antes de declararla, 632 de 1565 citas (40 %) llevaban `GEN` y
# `TASK-THYROX-*` era 0 — no porque el trabajo cruzara repos, sino porque
# nadie derivaba.
#
# Qué capas existen es dato del CONSUMIDOR, no del mecanismo; por eso es un
# archivo y no una tabla en el código. La de este árbol:
THYROX_LAYER_SIGNALS=src/task/layer_signals.tsv

# THYROX_FIXTURE_LEAK_SHARED — que directorio vigila el eje COMPARTIDO.
#
# `src/repo/fixture_leak.sh` mide dos ejes: `confined` es lo que quedo en su
# sonda —lo cierra el desvio de TMPDIR que `tests/run.sh` hace— y `shared` es
# lo que aparecio en el directorio compartido A PESAR del desvio, que solo
# puede venir de una plantilla de ruta fija y exige editar la suite.
#
# Cual es «el compartido» es dato del CONSUMIDOR: en este contenedor es
# `/tmp`, pero un arbol que corra con un TMPDIR propio, en otro montaje
# (/var/tmp, /dev/shm) o dentro de un sandbox tiene otro. Por eso se declara
# y no se cablea.
#
# Y quien MIDE al medidor lo apunta a un directorio propio: el eje compartido
# no puede saber QUIEN escribio, asi que con el default cualquier proceso
# vecino fabrica el positivo. Medido: bajo `run-task-pool --width 4` la suite
# daba ok=13 fallo=1 con el default y ok=17 fallo=0 con su directorio propio.
#
# Vacia = `/tmp`, el default del guion.
THYROX_FIXTURE_LEAK_SHARED=

# Segundos que `bg.sh start` espera en primer plano antes de devolver el
# control con el trabajo ya desprendido. Ventana del CONSUMIDOR (DEC-04): la
# medida es "cuanto puede bloquearse un turno sin dejar de sentirse vivo".
THYROX_BG_GRACE_SECONDS=25

# El `/proc/meminfo` que `run-task-pool.sh --memfree` lee para medir la
# memoria disponible. Vacia = `/proc/meminfo`. Existe para que una suite
# conduzca la memoria con un archivo sintetico sin consumirla de verdad.
THYROX_POOL_MEMINFO_PATH=

# El registro de trabajos `bg.sh start --memfree` vivos: un archivo por pid
# con su hora de arranque. Es lo que permite contar la memoria ENTRE
# lanzamientos independientes, que el pool de `run-task-pool` no ve. Vacia =
# `${TMPDIR:-/tmp}/thyrox-bg-memfree`. Un control lo apunta a un directorio
# propio para no contar los trabajos de un vecino.
THYROX_BG_MEMFREE_DIR=

# Cada cuantos segundos el vigilante de un trabajo `--memfree` mira
# `MemAvailable`. Bajo la MITAD de la cota y con dos o mas vivos, el mas joven
# se mata a si mismo; nunca el ultimo. Vacia = 2.
THYROX_BG_MEMFREE_POLL=

# --- El idioma de los identificadores del propio proveedor ------------------
# `check_identifier_language.py` lee su baseline y sus raíces de estas dos
# claves. Sin baseline declarado rehúsa con exit 2: un baseline vacío por
# defecto haría ver como nueva a deuda heredada real. El pre-commit de thyrox
# lo corre sobre los .py staged de src/ y tests/. Raíces separadas por «:».
#   IDENTIFIER_LANGUAGE_BASELINE=<THYROX_ROOT>/.claude/baselines/identifier_language_baseline.txt
#   IDENTIFIER_LANGUAGE_ROOTS=src:tests
IDENTIFIER_LANGUAGE_BASELINE=
IDENTIFIER_LANGUAGE_ROOTS=

# --- Claves leídas por el código, sin valor propio del consumidor --------
# Cada grupo lleva el archivo que la lee primero. Vacío = rige el default que
# ese archivo declara; se rellena sólo para corregirlo. La mayor parte son los
# conmutadores del cliente portado, renombrados de CLAUDE_CODE_* a THYROX_CODE_*
# (src/verify/renameEnvPrefix.ts). Las credenciales de cliente OAuth van vacías:
# thyrox no publica los identificadores embebidos de terceros.
# .claude/skills/thyrox/scripts/run-functional-evals.sh
THYROX_CLI=
# src/lib/toolchain.sh
THYROX_TOOLCHAIN_IPROUTE2_INSTALL_CMD=
THYROX_TOOLCHAIN_IP_BIN=
THYROX_TOOLCHAIN_RSYNC_BIN=
THYROX_TOOLCHAIN_RSYNC_INSTALL_CMD=
# src/packages/agent/QueryEngine.ts
THYROX_CODE_EAGER_FLUSH=
THYROX_CODE_IS_COWORK=
# src/packages/agent/attachments.ts
THYROX_CODE_DISABLE_ATTACHMENTS=
THYROX_CODE_ENABLE_TOKEN_USAGE_ATTACHMENT=
THYROX_CODE_SIMPLE=
THYROX_CODE_VERIFY_PLAN=
# src/packages/agent/background/fleet/fleetStore.ts
THYROX_CONFIG_HOME=
# src/packages/agent/background/fleet/renameFleetJob.ts
THYROX_JOB_DIR=
# src/packages/agent/background/fleet/rvServer.ts
THYROX_BG_RENDEZVOUS_SOCK=
THYROX_BG_STARTUP_WEDGE_MS=
# src/packages/agent/claudeInChrome/mcpServer.ts
THYROX_CHROME_PERMISSION_MODE=
# src/packages/agent/claudeInChromeSetup.ts
THYROX_CODE_ENABLE_CFC=
# src/packages/agent/commitAttribution.ts
THYROX_CODE_ENTRYPOINT=
# src/packages/agent/compaction/autoCompact.ts
THYROX_AUTOCOMPACT_PCT_OVERRIDE=
THYROX_CODE_AUTO_COMPACT_WINDOW=
THYROX_CODE_BLOCKING_LIMIT_OVERRIDE=
# src/packages/agent/compaction/snipCompactCore.ts
THYROX_CODE_MODEL=
# src/packages/agent/concurrentSessions.ts
THYROX_CODE_AGENT=
THYROX_CODE_MESSAGING_SOCKET=
THYROX_CODE_SESSION_KIND=
THYROX_CODE_SESSION_LOG=
THYROX_CODE_SESSION_NAME=
# src/packages/agent/context.ts
THYROX_CODE_DISABLE_1M_CONTEXT=
THYROX_CODE_MAX_CONTEXT_TOKENS=
# src/packages/agent/coordinatorMode.ts
THYROX_CODE_COORDINATOR_MODE=
# src/packages/agent/effort.ts
THYROX_CODE_ALWAYS_ENABLE_EFFORT=
THYROX_CODE_EFFORT_LEVEL=
THYROX_CODE_USE_BEDROCK=
THYROX_CODE_USE_FOUNDRY=
THYROX_CODE_USE_GEMINI=
THYROX_CODE_USE_OPENAI=
THYROX_CODE_USE_VERTEX=
# src/packages/agent/goalStopHook.ts
THYROX_CODE_DISABLE_GOAL=
THYROX_CODE_WORKFLOWS=
# src/packages/agent/hooks.ts
THYROX_CODE_SESSIONEND_HOOKS_TIMEOUT_MS=
THYROX_CODE_SHELL_PREFIX=
THYROX_TRANSCRIPT_PATH=
# src/packages/agent/idleTimeout.ts
THYROX_CODE_EXIT_AFTER_STOP_DELAY=
# src/packages/agent/internal/fileHistoryCore.ts
THYROX_CODE_DISABLE_FILE_CHECKPOINTING=
THYROX_CODE_ENABLE_SDK_FILE_CHECKPOINTING=
# src/packages/agent/internal/loopSentinelCore.ts
THYROX_CODE_LOOP_PERSISTENT=
# src/packages/agent/internal/macroFallback.ts
THYROX_CODE_VERSION=
# src/packages/agent/internal/queryConfig.ts
THYROX_CODE_DISABLE_FAST_MODE=
THYROX_CODE_EMIT_TOOL_USE_SUMMARIES=
# src/packages/agent/internal/stopHooksCore.ts
THYROX_CODE_ENABLE_PROMPT_SUGGESTION=
# src/packages/agent/prompts.ts
THYROX_CODE_OPUS_4_6_FAST_MODE_OVERRIDE=
# src/packages/agent/query.ts
THYROX_CODE_MAX_OUTPUT_TOKENS=
THYROX_CODE_STOP_HOOK_BLOCK_CAP=
# src/packages/agent/statusAlias.tsx
THYROX_CODE_CLIENT_CERT=
THYROX_CODE_CLIENT_KEY=
THYROX_CODE_SKIP_BEDROCK_AUTH=
THYROX_CODE_SKIP_FOUNDRY_AUTH=
THYROX_CODE_SKIP_VERTEX_AUTH=
# src/packages/agent/tasks.ts
THYROX_CODE_ENABLE_TASKS=
